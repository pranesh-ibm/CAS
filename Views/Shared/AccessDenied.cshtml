@{
    ViewData["Title"] = "Access Denied";
    Layout = "_LayoutNoFooter";
}

<style>
    .access-wrapper {
        min-height: calc(100vh - 70px);
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 30px;
        background: linear-gradient(135deg, #0b0c10, #1f2833, #124e66);
    }

    .access-box {
        width: 420px;
        padding: 45px 35px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        text-align: center;
        box-shadow: 0 14px 40px rgba(0,0,0,0.45);
        animation: fadeUp .8s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .icon {
        font-size: 70px;
        margin-bottom: 20px;
        color: #ff5c5c;
    }

    .btn-home {
        margin-top: 25px;
        padding: 12px 26px;
        border-radius: 8px;
        background: #124e66;
        color: #1f2833;
        border: none;
        font-weight: 600;
        letter-spacing: 0.4px;
        transition: 0.3s;
    }

        .btn-home:hover {
            background: #5ae6dd;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(102,252,241,0.35);
        }
</style>

<div class="access-wrapper">
    <div class="access-box">
        <div class="icon">🚫</div>

        <h2 style="color:Red"class="fw-bold">Access Denied</h2>

        <p  class="mt-3" style="opacity:.8;color:bisque">
            You do not have permission to view this page.<br />
            Please contact the administrator if this seems incorrect.
        </p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-home">
            Go to Home
        </a>
    </div>
</div>