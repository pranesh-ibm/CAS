@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>CAS | Admin Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f4f7f9;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Top Navbar */
        .navbar {
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        /* Dashboard Cards */
        .dashboard-card {
            border-radius: 12px;
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
        }

            .dashboard-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.15);
            }

        .card-icon {
            font-size: 2.5rem;
        }

        /* Responsive text */
        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
        }

    </style>
</head>

<body>
    <!-- ================= TOP NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white px-4 py-3 fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-primary" asp-controller="Admin" asp-action="Index">
                <i class="fas fa-hospital-symbol me-2"></i> Clinic Automation System
            </a>

            <div class="ms-auto d-flex align-items-center">
                <!-- Profile Dropdown -->
                <div class="dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user-circle fs-5 me-2"></i> Admin
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 180px;">
                        <li class="dropdown-header fw-bold text-secondary py-2 px-3">Account</li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center text-danger py-2 px-3"
                               asp-controller="CrediMgr" asp-action="Logout">
                                <i class="fas fa-sign-out-alt me-2"></i> Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    @* Main content *@
    <div class="container-fluid mt-5 pt-4">
        @RenderBody()  <!-- <- This is crucial -->
    </div>

    <!-- ================= DASHBOARD CONTENT ================= -->
    <div class="container-fluid mt-5 pt-4">
        <div class="text-center mb-4">
            <h1 class="fw-bold text-primary">Admin Dashboard</h1>
            @* <p class="text-muted">Manage all system modules from here</p> *@
        </div>

        <div class="row g-4">

            <!-- Patients -->
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Admin" asp-action="GetPatientsDetail" class="text-decoration-none text-dark">
                    <div class="card dashboard-card p-3 text-center bg-light">
                        <i class="fas fa-user-injured text-primary card-icon"></i>
                        <div class="card-title mt-2">Patients</div>
                    </div>
                </a>
            </div>

            <!-- Physicians -->
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Admin" asp-action="GetPhysiciansDetail" class="text-decoration-none text-dark">
                    <div class="card dashboard-card p-3 text-center bg-light">
                        <i class="fas fa-user-md text-success card-icon"></i>
                        <div class="card-title mt-2">Physicians</div>
                    </div>
                </a>
            </div>

            <!-- Chemists -->
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Admin" asp-action="GetChemistsDetail" class="text-decoration-none text-dark">
                    <div class="card dashboard-card p-3 text-center bg-light">
                        <i class="fas fa-capsules text-warning card-icon"></i>
                        <div class="card-title mt-2">Chemists</div>
                    </div>
                </a>
            </div>

            <!-- Suppliers -->
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Admin" asp-action="GetSuppliersDetail" class="text-decoration-none text-dark">
                    <div class="card dashboard-card p-3 text-center bg-light">
                        <i class="fas fa-truck text-danger card-icon"></i>
                        <div class="card-title mt-2">Suppliers</div>
                    </div>
                </a>
            </div>

            <!-- Appointments -->
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Admin" asp-action="GetAppointmentDetails" class="text-decoration-none text-dark">
                    <div class="card dashboard-card p-3 text-center bg-light">
                        <i class="fas fa-calendar-check text-info card-icon"></i>
                        <div class="card-title mt-2">Appointments</div>
                    </div>
                </a>
            </div>

            <!-- Schedules -->
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Admin" asp-action="GetScheduleDetails" class="text-decoration-none text-dark">
                    <div class="card dashboard-card p-3 text-center bg-light">
                        <i class="fas fa-clock text-secondary card-icon"></i>
                        <div class="card-title mt-2">Schedules</div>
                    </div>
                </a>
            </div>

            <!-- Pending Patients -->
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Admin" asp-action="PendingPatients" class="text-decoration-none text-dark">
                    <div class="card dashboard-card p-3 text-center bg-light">
                        <i class="fas fa-user-clock text-warning card-icon"></i>
                        <div class="card-title mt-2">Pending Patients</div>
                    </div>
                </a>
            </div>

            <!-- Pending Appointments -->
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Admin" asp-action="PendingAppointments" class="text-decoration-none text-dark">
                    <div class="card dashboard-card p-3 text-center bg-light">
                        <i class="fas fa-exclamation-circle text-danger card-icon"></i>
                        <div class="card-title mt-2">Pending Appointments</div>
                    </div>
                </a>
            </div>

        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
