<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CAS</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* ================= GLOBAL ANIMATED BACKGROUND ================= */
        body {
            background: linear-gradient( -45deg, #212A31, #2E3944, #124E66, #748D92 );
            background-size: 400% 400%;
            animation: gradientFlow 15s ease infinite;
            min-height: 100vh;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Background Animation */
        @@keyframes gradientFlow {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        /* ================= NAVBAR ================= */
        .glass-nav {
            background: linear-gradient( 90deg, #212A31, #124E66 );
            box-shadow: 0 5px 20px rgba(0,0,0,0.4);
            backdrop-filter: blur(6px);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            color: #D3D9D4 !important;
        }

        .nav-link {
            color: #D3D9D4 !important;
            margin-right: 25px;
            position: relative;
            transition: 0.3s;
        }

            .nav-link::after {
                content: "";
                position: absolute;
                width: 0%;
                height: 2px;
                left: 0;
                bottom: -5px;
                background: #748D92;
                transition: 0.3s;
            }

            .nav-link:hover::after {
                width: 100%;
            }

        /* ================= CONTENT WRAPPER ================= */
        .content-wrapper {
            margin-top: 110px;
            padding: 40px;
            background: rgba(211, 217, 212, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            animation: fadeUp 0.8s ease;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ================= HEADINGS ================= */
        h1, h2, h3, h4, h5 {
            color: #124E66;
            font-weight: 600;
        }

        /* ================= PRIMARY BUTTON (HEAVY ANIMATION) ================= */
        .btn-modern {
            position: relative;
            background: linear-gradient( 45deg, #124E66, #748D92 );
            color: white;
            border-radius: 40px;
            padding: 10px 30px;
            border: none;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 0 15px rgba(18,78,102,0.6);
        }

            /* Glow Animation */
            .btn-modern:hover {
                transform: translateY(-5px) scale(1.05);
                box-shadow: 0 0 25px rgba(18,78,102,0.9), 0 0 40px rgba(116,141,146,0.7);
            }

            /* Pulse Effect */
            .btn-modern::before {
                content: "";
                position: absolute;
                width: 120%;
                height: 120%;
                background: radial-gradient(circle, rgba(255,255,255,0.3) 10%, transparent 60%);
                top: -10%;
                left: -10%;
                opacity: 0;
                transition: 0.4s;
            }

            .btn-modern:hover::before {
                opacity: 1;
            }

        /* Secondary Button */
        .btn-secondary-modern {
            background: #212A31;
            color: #D3D9D4;
            border-radius: 40px;
            padding: 10px 30px;
            transition: 0.4s;
        }

            .btn-secondary-modern:hover {
                background: #124E66;
                transform: translateY(-4px);
            }

        /* ================= FOOTER ================= */
        footer {
            margin-top: 60px;
            padding: 20px 0;
            text-align: center;
            font-size: 14px;
            color: #D3D9D4;
            opacity: 0.85;
        }

    </style>
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-dark glass-nav fixed-top">
        <div class="container">

            <a class="navbar-brand"
               asp-action="Index">
                MEDAXIS
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Privacy">
                            Privacy
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            

            <li class="nav-item">
                <form asp-controller="CrediMgr"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    <button type="submit"
                            class="btn btn-modern btn-sm">
                        Logout
                    </button>

                </form>
            </li>
        }

    </ul>
                

            </div>
        </div>
    </nav>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="container content-wrapper">
        @RenderBody()
    </div>

    <!-- ================= FOOTER ================= -->
    <footer>
        © 2026 MEDAXIS • Home Panel
    </footer>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_SuccessModal")

</body>
</html>
