@model CAS.Models.Supplier

@{
    ViewData["Title"] = "Supplier Dashboard";
    Layout = "~/Views/Shared/_LayoutRoles.cshtml";
}

<style>

    /* ================= PREMIUM BACKGROUND ================= */
    .dashboard-wrapper {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .dashboard-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .dashboard-subtitle {
        color: rgba(255,255,255,0.8);
    }

    /* ================= GLASS WELCOME CARD ================= */
    .welcome-card {
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(10px);
        color: #AFDDE5;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        animation: fadeUp 0.8s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .welcome-card h4 {
        color: #D3D9D4;
        font-weight: 700;
    }

    .welcome-card p {
        color: rgba(255,255,255,0.85);
    }

    /* ================= FUNCTIONAL CARDS ================= */
    .dashboard-card {
        background: white;
        padding: 35px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        transition: all 0.35s ease;
        position: relative;
        overflow: hidden;
    }

        .dashboard-card::before {
            content: "";
            position: absolute;
            width: 200%;
            height: 200%;
            top: -150%;
            left: -50%;
            background: linear-gradient(45deg,#0FA4AF,#AFDDE5);
            opacity: 0.08;
            transition: 0.5s;
            transform: rotate(25deg);
            pointer-events: none;
            z-index: 0;
        }

        .dashboard-card:hover::before {
            top: -50%;
        }

        .dashboard-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 60px rgba(0,0,0,0.2);
        }

        .dashboard-card * {
            position: relative;
            z-index: 2;
        }

        .dashboard-card h5 {
            color: #024950;
            font-weight: 700;
            margin-bottom: 25px;
        }

    /* ================= ICON STYLE ================= */
    .dashboard-icon {
        font-size: 40px;
        color: #0FA4AF;
        margin-bottom: 15px;
    }

    /* ================= BUTTON STYLE ================= */
    .dashboard-btn {
        display: block;
        width: 100%;
        padding: 12px;
        border-radius: 30px;
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .dashboard-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(15,164,175,0.7);
            color: white;
        }

    .dashboard-btn-outline {
        display: block;
        width: 100%;
        padding: 12px;
        border-radius: 30px;
        border: 2px solid #964734;
        color: #964734;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .dashboard-btn-outline:hover {
            background: #964734;
            color: white;
            transform: scale(1.05);
        }

</style>

<div class="dashboard-wrapper">
    <div class="container">

        <!-- HEADER -->
        <div class="text-center mb-5">
            <h2 class="dashboard-title">Supplier Dashboard</h2>
            <p class="dashboard-subtitle">
                Manage your profile and supply operations efficiently
            </p>
        </div>

        <div class="row g-4">

            <!-- LEFT WELCOME PANEL -->
            <div class="col-lg-4">
                <div class="welcome-card h-100 d-flex flex-column justify-content-center">
                    <h4>Welcome, @Model.SupplierName 👋</h4>
                    <p class="mt-3">
                        Monitor supply orders, manage your profile,
                        and track order history from one place.
                    </p>
                </div>
            </div>

            <!-- RIGHT CARDS -->
            <div class="col-lg-8">
                <div class="row g-4">

                    <!-- PROFILE -->
                    <div class="col-md-6">
                        <div class="dashboard-card h-100">
                            <div class="dashboard-icon">🏢</div>
                            <h5>My Profile</h5>
                            <a asp-action="EditProfile"
                               class="dashboard-btn">
                                Edit Profile
                            </a>
                        </div>
                    </div>

                    <!-- PENDING ORDERS -->
                    <div class="col-md-6">
                        <div class="dashboard-card h-100">
                            <div class="dashboard-icon">📦</div>
                            <h5>Pending Orders</h5>
                            <a asp-action="PendingOrders"
                               class="dashboard-btn">
                                View Pending
                            </a>
                        </div>
                    </div>

                    <!-- ORDER HISTORY -->
                    <div class="col-md-6">
                        <div class="dashboard-card h-100">
                            <div class="dashboard-icon">📋</div>
                            <h5>Order History</h5>
                            <a asp-action="OrderHistory"
                               class="dashboard-btn-outline">
                                View History
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
