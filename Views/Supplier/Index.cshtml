@model CAS.Models.Supplier

<div class="container mt-4">

    <h2>My Profile</h2>

    <div class="card p-4 mb-4 shadow-sm">
        <p><strong>Name:</strong> @Model.SupplierName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.Phone</p>
        <p><strong>Address:</strong> @Model.Address</p>
    </div>

    <h4>Quick Actions</h4>

    <a href="/Supplier/PendingOrders" class="btn btn-warning me-2">
        View Pending Orders
    </a>

    <a href="/Supplier/OrderHistory" class="btn btn-secondary">
        Order History
    </a>

</div>
