@model List<CAS.Models.PurchaseOrderHeader>

<div class="container mt-4">

    <h2>Order History</h2>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>PO No</th>
                <th>Date</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Pono</td>
                    <td>@order.Podate</td>
                    <td>@order.PoStatus</td>
                </tr>
            }
        </tbody>
    </table>

</div>
