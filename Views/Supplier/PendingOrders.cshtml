@model IEnumerable<CAS.Models.PurchaseOrderHeader>

@{
    ViewData["Title"] = "Pending Orders";
    Layout = "~/Views/Shared/_LayoutRoles.cshtml";
}

<style>

    /* ================= BACKGROUND ================= */
    .orders-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= ORDER CARD ================= */
    .order-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 30px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.25);
        transition: 0.35s ease;
        position: relative;
        overflow: hidden;
    }

        .order-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 35px 70px rgba(0,0,0,0.3);
        }

        .order-card::before {
            content: "";
            position: absolute;
            height: 6px;
            width: 100%;
            top: 0;
            left: 0;
            background: linear-gradient(45deg,#0FA4AF,#964734);
        }

    /* ================= INFO ================= */
    .info-label {
        font-weight: 600;
        color: #003135;
    }

    .info-value {
        color: #555;
        margin-bottom: 10px;
    }

    /* ================= TABLE STYLE ================= */
    .order-table th {
        background: #f8f9fa;
        font-weight: 600;
    }

    .order-table td {
        vertical-align: middle;
    }

    /* ================= BUTTONS ================= */
    .btn-approve {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        border: none;
        border-radius: 30px;
        padding: 8px 20px;
        font-weight: 600;
        color: white;
        transition: 0.3s ease;
    }

        .btn-approve:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(15,164,175,0.6);
            color: white;
        }

    .btn-reject {
        border-radius: 30px;
        padding: 8px 20px;
        font-weight: 600;
        border: 2px solid #964734;
        color: #964734;
        background: transparent;
        transition: 0.3s;
    }

        .btn-reject:hover {
            background: #964734;
            color: white;
            transform: scale(1.05);
        }

    /* ================= EMPTY STATE ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        color: #AFDDE5;
    }

</style>

<div class="orders-page">

    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-5">

            <h2 class="page-title mb-0">Pending Orders</h2>

            <a asp-controller="Supplier"
               asp-action="Index"
               class="btn btn-outline-light rounded-pill px-4 fw-semibold">
                ← Back to Dashboard
            </a>

        </div>

        @if (!Model.Any())
        {
            <div class="custom-alert">
                <h5 style="color:bisque" class="mb-3">📦 No Pending Orders</h5>
                <p class="mb-0">
                    There are no pending purchase orders at the moment.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var order in Model)
                {
                    <div class="col-lg-8 col-md-10 mx-auto">

                        <div class="order-card">

                            <div class="mb-3">
                                <span class="info-label">PO No:</span>
                                <span class="info-value">@order.Pono</span>
                            </div>

                            <div class="mb-4">
                                <span class="info-label">Date:</span>
                                <span class="info-value">
                                    @order.Podate.ToString("dd MMM yyyy")
                                </span>
                            </div>

                            <table class="table table-bordered order-table mb-4">
                                <thead>
                                    <tr>
                                        <th>Medicine</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.PurchaseProductLines)
                                    {
                                        <tr>
                                            <td>@item.Drug.DrugTitle</td>
                                            <td>@item.Qty</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="text-end">
                                <a asp-action="Approve"
                                   asp-route-id="@order.Poid"
                                   class="btn-approve me-2">
                                    ✔ Approve
                                </a>

                                <a asp-action="Reject"
                                   asp-route-id="@order.Poid"
                                   class="btn-reject">
                                    ✖ Reject
                                </a>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>
