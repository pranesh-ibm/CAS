@model List<CAS.Models.PurchaseOrderHeader>

<div class="container mt-4">

    <h2>Pending Orders</h2>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>PO No</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Pono</td>
                    <td>@order.Podate</td>
                    <td>
                        <a href="/Supplier/Approve/@order.Poid"
                           class="btn btn-success btn-sm">
                            Approve
                        </a>

                        <a href="/Supplier/Reject/@order.Poid"
                           class="btn btn-danger btn-sm">
                            Reject
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
