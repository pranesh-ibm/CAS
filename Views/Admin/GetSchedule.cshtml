@model IEnumerable<CAS.Models.Schedule>

@{
    ViewData["Title"] = "Schedules";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- ================= PAGE HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Schedules Management</h2>
            <p class="text-muted mb-0">Manage all schedules and assigned appointments</p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="fas fa-plus me-2"></i> Add Schedule
        </a>
    </div>

    <!-- ================= TABLE CARD ================= -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Appointment ID</th>
                            <th>Physician</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ScheduleDate.ToString("dd MMM yyyy")</td>
                                <td>@item.ScheduleTime.ToString(@"hh\:mm")</td>

                                <!-- Status Badge -->
                                <td>
                                    @if (item.ScheduleStatus == "Scheduled")
                                    {
                                        <span class="badge bg-success">Scheduled</span>
                                    }
                                    else if (item.ScheduleStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (item.ScheduleStatus == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.ScheduleStatus</span>
                                    }
                                </td>

                                <td>@item.Appointment.AppointmentId</td>
                                <td>@item.Physician.PhysicianName</td>

                                <!-- Action Buttons -->
                                <td class="text-end">
                                    <a asp-action="GetScheduleById"
                                       asp-route-id="@item.ScheduleId"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
