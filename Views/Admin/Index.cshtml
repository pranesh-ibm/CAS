@model CAS.Models.ViewModel.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<style>

    /* ================= WRAPPER ================= */
    .admin-dashboard {
        padding: 40px 0 20px 0;
        animation: fadeIn 0.8s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================= HEADER ================= */
    .dashboard-header h2 {
        font-weight: 800;
        font-size: 30px;
        background: linear-gradient(90deg,#0FA4AF,#748D92,#D3D9D4);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .dashboard-sub {
        color: #D3D9D4;
        opacity: 0.85;
        font-weight: 500;
    }

    /* ================= STAT CARDS ================= */
    .stat-card {
        border-radius: 22px;
        padding: 30px;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0,0,0,0.35);
        transition: all 0.4s ease;
    }

        .stat-card::before {
            content: "";
            position: absolute;
            width: 200%;
            height: 200%;
            top: -120%;
            left: -50%;
            background: rgba(255,255,255,0.15);
            transform: rotate(25deg);
            transition: 0.5s;
        }

        .stat-card:hover::before {
            top: -30%;
        }

        .stat-card:hover {
            transform: translateY(-8px);
        }

    /* Gradient Variants */
    .bg-patients {
        background: linear-gradient(135deg,#124E66,#0FA4AF);
    }

    .bg-physicians {
        background: linear-gradient(135deg,#2E3944,#124E66);
    }

    .bg-chemists {
        background: linear-gradient(135deg,#964734,#C05746);
    }

    .bg-suppliers {
        background: linear-gradient(135deg,#8B0000,#C0392B);
    }

    .stat-card h6 {
        font-size: 14px;
        opacity: 0.9;
        font-weight: 600;
    }

    .stat-card h2 {
        font-size: 34px;
        font-weight: 800;
        margin-top: 8px;
    }

    /* ================= INFO CARDS ================= */
    .info-card {
        border-radius: 22px;
        padding: 30px;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,0.15);
        box-shadow: 0 25px 50px rgba(0,0,0,0.35);
        transition: 0.4s ease;
        color: #D3D9D4;
        position: relative;
    }

        .info-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 35px 70px rgba(0,0,0,0.45);
        }

        .info-card h5 {
            font-weight: 700;
            margin-bottom: 15px;
            color: #ffffff;
        }

    .info-number {
        font-size: 34px;
        font-weight: 900;
    }

    /* Accent Colors */
    .text-pending {
        color: #FFB703;
    }

    .text-danger-soft {
        color: #E63946;
    }

    .text-info-soft {
        color: #0FA4AF;
    }

    /* Divider */
    .section-divider {
        margin: 50px 0;
        height: 2px;
        background: linear-gradient(90deg,#124E66,#748D92);
        border-radius: 5px;
        opacity: 0.6;
    }

</style>

<div class="admin-dashboard">

    <div class="container-fluid">

        <!-- HEADER -->
        <div class="dashboard-header mb-5">
            <h2>Dashboard Overview</h2>
            <div class="dashboard-sub">
                Real-time statistics of the Clinic Automation System
            </div>
        </div>

        <!-- MAIN STATS -->
        <div class="row g-4 mb-5">

            <div class="col-xl-3 col-md-6">
                <div class="stat-card bg-patients">
                    <h6>Total Patients</h6>
                    <h2>@Model.TotalPatients</h2>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card bg-physicians">
                    <h6>Total Physicians</h6>
                    <h2>@Model.TotalPhysicians</h2>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card bg-chemists">
                    <h6>Total Chemists</h6>
                    <h2>@Model.TotalChemists</h2>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card bg-suppliers">
                    <h6>Total Suppliers</h6>
                    <h2>@Model.TotalSuppliers</h2>
                </div>
            </div>

        </div>


        <!-- SECOND ROW -->
        <div class="row g-4">

            <div class="col-lg-4">
                <div class="info-card text-center">
                    <h5>Pending Patients</h5>
                    <div class="info-number text-pending">
                        @Model.PendingPatients
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="info-card text-center">
                    <h5>Pending Appointments</h5>
                    <div class="info-number text-danger-soft">
                        @Model.PendingAppointments
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="info-card text-center">
                    <h5>Today's Appointments</h5>
                    <div class="info-number text-info-soft">
                        @Model.TodayAppointments
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
