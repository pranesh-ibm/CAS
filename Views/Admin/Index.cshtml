@model CAS.Models.ViewModel.AdminDashboardViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- ================= HEADER ================= -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark">Dashboard Overview</h2>
        @* <p class="text-muted mb-0">Real-time statistics of the Clinic Automation System</p> *@
    </div>

    <!-- ================= STAT CARDS ================= -->
    <div class="container mt-4">

        

        <div class="row">

            <!-- Patients -->
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3 shadow">
                    <div class="card-body">
                        <h5>Total Patients</h5>
                        <h2>@Model.TotalPatients</h2>
                    </div>
                </div>
            </div>

            <!-- Physicians -->
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3 shadow">
                    <div class="card-body">
                        <h5>Total Physicians</h5>
                        <h2>@Model.TotalPhysicians</h2>
                    </div>
                </div>
            </div>

            <!-- Chemists -->
            <div class="col-md-3">
                <div class="card text-white bg-warning mb-3 shadow">
                    <div class="card-body">
                        <h5>Total Chemists</h5>
                        <h2>@Model.TotalChemists</h2>
                    </div>
                </div>
            </div>

            <!-- Suppliers -->
            <div class="col-md-3">
                <div class="card text-white bg-danger mb-3 shadow">
                    <div class="card-body">
                        <h5>Total Suppliers</h5>
                        <h2>@Model.TotalSuppliers</h2>
                    </div>
                </div>
            </div>

        </div>

        <div class="row mt-3">

            <!-- Pending Patients -->
            <div class="col-md-4">
                <div class="card border-warning shadow">
                    <div class="card-body">
                        <h5>Pending Patients</h5>
                        <h3 class="text-warning">@Model.PendingPatients</h3>
                    </div>
                </div>
            </div>

            <!-- Pending Appointments -->
            <div class="col-md-4">
                <div class="card border-danger shadow">
                    <div class="card-body">
                        <h5>Pending Appointments</h5>
                        <h3 class="text-danger">@Model.PendingAppointments</h3>
                    </div>
                </div>
            </div>

            <!-- Today's Appointments -->
            <div class="col-md-4">
                <div class="card border-info shadow">
                    <div class="card-body">
                        <h5>Today's Appointments</h5>
                        <h3 class="text-info">@Model.TodayAppointments</h3>
                    </div>
                </div>
            </div>

        </div>

    </div>

    </div>
</div>
