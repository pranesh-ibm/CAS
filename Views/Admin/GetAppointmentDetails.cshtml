@model IEnumerable<CAS.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .btn-back {
        border: 2px solid white;
        color: white;
        border-radius: 30px;
        padding: 8px 20px;
        font-weight: 600;
        background: transparent;
        transition: 0.3s ease;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #124E66;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(18,78,102,0.3);
            text-decoration: none;
        }

    .appointments-page {
        background: linear-gradient(135deg,#0f2027,#203a43,#2c5364);
        padding: 60px 0;
        min-height: 100vh;
    }

    .table-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.25);
    }

    .table thead {
        background: linear-gradient(45deg,#2c5364,#203a43);
        color: white;
    }

        .table thead th {
            border: none;
            padding: 14px;
        }

    .table tbody td {
        padding: 14px;
        vertical-align: middle;
    }

    .status-badge {
        padding: 6px 14px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 13px;
        color: white;
    }

    .scheduled {
        background: #28a745;
    }

    .pending {
        background: #ffc107;
        color: black;
    }

    .cancelled {
        background: #dc3545;
    }
</style>

<div class="appointments-page">
    <div class="container">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-light fw-bold">
                Appointments Overview
            </h2>

            <a asp-controller="Admin"
               asp-action="Index"
               class="btn-back">
                ← Back
            </a>
        </div>

        <!-- Table -->
        <div class="table-card">
            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Date & Time</th>
                            <th>Criticality</th>
                            <th>Reason</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td>@appt.Patient?.PatientName</td>
                                <td>@appt.AppointmentDate.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td>@appt.Criticality</td>
                                <td>@appt.Reason</td>
                                <td>@appt.Patient?.Phone</td>
                                <td>@appt.Patient?.Email</td>
                                <td>
                                    @{
                                        string badgeClass = "cancelled";

                                        if (appt.ScheduleStatus == "Scheduled")
                                        {
                                            badgeClass = "scheduled";
                                        }
                                        else if (appt.ScheduleStatus == "Pending")
                                        {
                                            badgeClass = "pending";
                                        }
                                    }

                                    <span class="status-badge @badgeClass">
                                        @appt.ScheduleStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>

    </div>
</div>
