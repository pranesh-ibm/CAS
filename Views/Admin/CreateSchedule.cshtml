@model CAS.Models.Appointment

@{
    ViewData["Title"] = "Assign Doctor";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .btn-back {
        border: 2px solid #124E66;
        color: #124E66;
        border-radius: 30px;
        padding: 8px 20px;
        font-weight: 600;
        background: transparent;
        transition: 0.3s ease;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #124E66;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(18,78,102,0.3);
        }

    :root {
        --dark1: #212A31;
        --dark2: #2E3944;
        --accent: #124E66;
        --muted: #748D92;
        --light: #D3D9D4;
    }

    /* ================= BACKGROUND ================= */
    .assign-page {
        background: linear-gradient(135deg, var(--dark1), var(--dark2), var(--accent));
        background-size: 300% 300%;
        animation: bgShift 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgShift {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= CARD ================= */
    .assign-card {
        background: rgba(255,255,255,0.92);
        border-radius: 22px;
        padding: 40px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.35);
        backdrop-filter: blur(8px);
        animation: fadeUp 0.8s ease;
        border-left: 6px solid var(--accent);
        transition: 0.35s ease;
    }

        .assign-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 35px 80px rgba(0,0,0,0.45);
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================= HEADER ================= */
    .assign-title {
        font-weight: 800;
        font-size: 28px;
        color: var(--accent);
        text-align: center;
        margin-bottom: 25px;
        position: relative;
        display: inline-block;
        animation: titleFade 0.8s ease;
    }

    @@keyframes titleFade {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .assign-title::after {
        content: "";
        width: 60%;
        height: 4px;
        background: linear-gradient(90deg, var(--accent), var(--muted));
        position: absolute;
        left: 50%;
        bottom: -6px;
        transform: translateX(-50%);
        border-radius: 20px;
        animation: lineGrow 1s ease forwards;
    }

    @@keyframes lineGrow {
        from {
            width: 0;
            opacity: 0;
        }

        to {
            width: 60%;
            opacity: 1;
        }
    }

    /* ================= INPUTS ================= */
    .form-label {
        font-weight: 600;
        color: var(--dark2);
        margin-bottom: 6px;
    }

    .form-control {
        border-radius: 14px;
        padding: 12px 16px;
        border: 1px solid var(--light);
        transition: 0.3s ease;
        font-weight: 500;
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(18,78,102,0.2);
            transform: scale(1.02);
        }

    /* ================= BUTTON ================= */
    .btn-assign {
        background: linear-gradient(45deg, var(--accent), var(--muted));
        border: none;
        padding: 12px 32px;
        border-radius: 30px;
        color: white;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: 0.3s ease;
        margin-top: 10px;
    }

        .btn-assign:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 30px rgba(18,78,102,0.45);
        }
</style>

<div class="assign-page">
    <div class="container">
        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="assign-card">
                    <div class="mb-3">

                        <a asp-controller="Admin" asp-action="PendingAppointments" class="btn-back">
                            ← Back
                        </a>
                    </div>


                    <h2 class="assign-title">Assign Doctor</h2>

                    <form asp-action="AssignDoctorPost" method="post">

                        <input type="hidden" name="AppointmentID" value="@Model.AppointmentId" />

                        <div class="mb-4">
                            <label class="form-label">Select Doctor</label>
                            <select name="PhysicianID"
                                    asp-items="ViewBag.Physicians"
                                    class="form-control"
                                    required>
                                <option value="">-- Select Doctor --</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Select Date</label>
                            <input type="date"
                                   name="ScheduleDate"
                                   value="@Model.AppointmentDate.ToString("yyyy-MM-dd")"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Select Time</label>
                            <input type="time"
                                   name="ScheduleTime"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn-assign">
                                Assign Doctor
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>
</div>
