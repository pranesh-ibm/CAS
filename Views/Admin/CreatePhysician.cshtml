@model CAS.Models.Physician

@{
    ViewData["Title"] = "Create Physician";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    :root {
        --dark-1: #212A31;
        --dark-2: #2E3944;
        --accent: #124E66;
        --muted: #748D92;
        --light: #D3D9D4;
    }

    /* ================= BACKGROUND ================= */
    .create-page {
        background: linear-gradient(135deg, var(--dark-1), var(--dark-2), var(--accent));
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 70px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= CARD ================= */
    .create-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 45px;
        box-shadow: 0 25px 55px rgba(0,0,0,0.35);
        backdrop-filter: blur(10px);
        animation: fadeUp 0.8s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(35px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================= HEADINGS ================= */
    .page-title {
        font-weight: 800;
        color: var(--light);
    }

    .page-subtitle {
        color: #d7e2e3;
        font-size: 14px;
    }

    .section-title {
        color: var(--accent);
        font-weight: 700;
        margin-bottom: 20px;
    }

    /* ================= FORM FIELDS ================= */
    .form-label {
        font-weight: 600;
        color: var(--dark-2);
    }

    .form-control {
        border-radius: 14px;
        padding: 12px 15px;
        border: 1px solid var(--light);
        transition: 0.3s ease;
        background: #fff;
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(18,78,102,0.25);
        }

    /* ================= BUTTONS ================= */
    .btn-premium {
        border-radius: 30px;
        padding: 12px 35px;
        font-weight: 700;
        transition: 0.3s ease;
        letter-spacing: 0.4px;
    }

    .btn-create {
        background: linear-gradient(45deg, var(--accent), var(--dark-2));
        color: white;
        border: none;
        position: relative;
        overflow: hidden;
    }

        .btn-create:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 30px rgba(18,78,102,0.45);
        }

        /* Ripple effect */
        .btn-create::after {
            content: "";
            position: absolute;
            width: 0;
            height: 0;
            top: 50%;
            left: 50%;
            background: rgba(255,255,255,0.3);
            transform: translate(-50%, -50%);
            border-radius: 50%;
            transition: 0.5s;
        }

        .btn-create:hover::after {
            width: 300%;
            height: 300%;
        }

    .btn-back {
        border-radius: 30px;
        padding: 10px 30px;
        border: 2px solid var(--light);
        color: var(--dark);
        font-weight: 600;
        transition: 0.3s ease;
    }

        .btn-back:hover {
            background: var(--dark);
            color: var(--light);
            transform: scale(1.05);
        }

</style>


<div class="create-page">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="page-title">Create New Physician</h2>
            <p class="page-subtitle">Fill out the details to register a new physician</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-7">

                <div class="create-card">

                    <h4 class="section-title">Physician Information</h4>

                    <form asp-action="CreatePhysician">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-4">

                            <div class="col-md-12">
                                <label asp-for="PhysicianName" class="form-label"></label>
                                <input asp-for="PhysicianName" class="form-control" />
                                <span asp-validation-for="PhysicianName" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Specialization" class="form-label"></label>
                                <input asp-for="Specialization" class="form-control" />
                                <span asp-validation-for="Specialization" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Address" class="form-label"></label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Summary" class="form-label"></label>
                                <textarea asp-for="Summary" rows="3" class="form-control"></textarea>
                                <span asp-validation-for="Summary" class="text-danger"></span>
                            </div>

                            <div class="col-12 text-center mt-4">
                                <button type="submit" class="btn-premium btn-create me-3">
                                    Create Physician
                                </button>

                                <a asp-action="GetPhysiciansDetail" class="btn-back">
                                    Back to List
                                </a>
                            </div>

                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</div>
