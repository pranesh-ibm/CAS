@model IEnumerable<CAS.Models.Schedule>

@{
    ViewData["Title"] = "Schedule Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- ================= PAGE HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Schedule Details</h2>
            @* <p class="text-muted mb-0">View all scheduled appointments with assigned physicians</p> *@
        </div>
    </div>

    <!-- ================= TABLE CARD ================= -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient Name</th>
                            <th>Physician</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ScheduleDate.ToString("dd MMM yyyy")</td>
                                <td>@item.ScheduleTime.ToString(@"hh\:mm")</td>
                                <td>@item.Appointment.Patient.PatientName</td>
                                <td>@item.Physician.PhysicianName</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
