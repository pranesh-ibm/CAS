@model IEnumerable<CAS.Models.Chemist>

@{
    ViewData["Title"] = "Chemists";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .btn-back {
        border: 2px solid #124E66;
        color: #124E66;
        border-radius: 30px;
        padding: 8px 20px;
        font-weight: 600;
        background: transparent;
        transition: 0.3s ease;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #124E66;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(18,78,102,0.3);
        }


    /* ================= PAGE BACKGROUND ================= */
    .admin-page {
        background: linear-gradient(135deg,#f4f7fb,#e8edf5);
        padding: 40px 0 20px 0;
    }

    /* ================= HEADER ================= */
    .page-title {
        font-weight: 800;
        color: #1f2937;
    }

    .page-subtitle {
        color: #6b7280;
        font-size: 14px;
    }

    .btn-add {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        border: none;
        border-radius: 30px;
        padding: 10px 22px;
        font-weight: 600;
        color: white;
        transition: 0.3s ease;
    }

        .btn-add:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(15,164,175,0.4);
            color: white;
        }

    /* ================= CARD ================= */
    .premium-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    /* ================= TABLE ================= */
    .table thead {
        background: linear-gradient(45deg,#124E66,#748D92);
        color: white;
    }

        .table thead th {
            border: none;
            padding: 15px;
        }

    .table tbody td {
        padding: 14px;
        vertical-align: middle;
    }

    .table tbody tr {
        transition: 0.25s ease;
    }

        .table tbody tr:hover {
            background-color: rgba(15,164,175,0.08);
            transform: scale(1.01);
        }

    /* ================= STATUS BADGES ================= */
    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
    }

    .status-pending {
        background: #ffc107;
        color: #000;
    }

    .status-other {
        background: #6c757d;
        color: white;
    }

    /* ================= ACTION BUTTONS ================= */
    .action-btn {
        border-radius: 20px;
        padding: 6px 12px;
        transition: 0.25s ease;
        border: none;
    }

    .btn-edit {
        background: #e0f2fe;
        color: #0284c7;
    }

        .btn-edit:hover {
            background: #0284c7;
            color: white;
            transform: scale(1.05);
        }

    .btn-view {
        background: #e0f7f1;
        color: #0FA4AF;
    }

        .btn-view:hover {
            background: #0FA4AF;
            color: white;
            transform: scale(1.05);
        }

    .btn-delete {
        background: #fee2e2;
        color: #dc3545;
    }

        .btn-delete:hover {
            background: #dc3545;
            color: white;
            transform: scale(1.05);
        }

</style>

<div class="admin-page">

    <div class="container-fluid px-4">

        <!-- ================= HEADER ================= -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a asp-controller="Admin" asp-action="Index" class="btn-back mb-3">
                    ← Back
                </a>
                <h2>  </h2>
                <h2 class="page-title mb-1">Chemists Management</h2>
                <p class="page-subtitle mb-0">
                    Manage and monitor all registered chemists
                </p>
            </div>

            <a asp-action="CreateChemist" class="btn btn-add">
                <i class="fas fa-plus me-2"></i> Add New Chemist
            </a>
        </div>

        <!-- ================= TABLE CARD ================= -->
        <div class="premium-card p-3">

            <div class="table-responsive">
                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Summary</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">@item.ChemistName</td>

                                <td>@item.Address</td>

                                <td>@item.Phone</td>

                                <td>@item.Email</td>

                                <td>@item.Summary</td>

                                <!-- STATUS -->
                                <td>
                                    @if (item.ChemistStatus == "Active")
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else if (item.ChemistStatus == "Pending")
                                    {
                                        <span class="status-badge status-pending">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-other">@item.ChemistStatus</span>
                                    }
                                </td>

                                <!-- ACTION BUTTONS -->
                                <td class="text-end">

                                    <a asp-action="EditChemist"
                                       asp-route-id="@item.ChemistId"
                                       class="btn action-btn btn-edit me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <a asp-action="GetChemistDetails"
                                       asp-route-id="@item.ChemistId"
                                       class="btn action-btn btn-view me-1">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <a asp-action="DeleteChemist"
                                       asp-route-id="@item.ChemistId"
                                       class="btn action-btn btn-delete">
                                        <i class="fas fa-trash"></i>
                                    </a>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>

    </div>

</div>
