@model IEnumerable<CAS.Models.Patient>

@{
    ViewData["Title"] = "Pending Patients";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- ================= PAGE HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Pending Patients</h2>
            <p class="text-muted mb-0">Review and approve or deny pending patient registrations</p>
        </div>
    </div>

    <!-- ================= TABLE CARD ================= -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="GetPatientDetails"
                                       asp-route-id="@item.PatientId"
                                       class="text-decoration-none fw-medium">
                                        @item.PatientName
                                    </a>
                                </td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td class="text-end">
                                    <a asp-action="Approve"
                                       asp-route-id="@item.PatientId"
                                       class="btn btn-success btn-sm me-1">
                                        <i class="fas fa-check me-1"></i> Approve
                                    </a>

                                    <a asp-action="Deny"
                                       asp-route-id="@item.PatientId"
                                       class="btn btn-danger btn-sm">
                                        <i class="fas fa-times me-1"></i> Deny
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
