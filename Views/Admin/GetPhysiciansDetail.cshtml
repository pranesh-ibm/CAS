@model IEnumerable<CAS.Models.Physician>

@{
    ViewData["Title"] = "Physicians";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- ================= PAGE HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Physicians Management</h2>
            <p class="text-muted mb-0">Manage and monitor all registered physicians</p>
        </div>

        <a asp-action="CreatePhysician" class="btn btn-primary px-4">
            <i class="fas fa-plus me-2"></i> Add New Physician
        </a>
    </div>

    <!-- ================= TABLE CARD ================= -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Specialization</th>
                            <th>Address</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.PhysicianName</td>
                                <td>@item.Specialization</td>
                                <td>@item.Address</td>
                                <td>@item.Phone</td>
                                <td>@item.Email</td>

                                <!-- Status Badge -->
                                <td>
                                    @if (item.PhysicianStatus == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (item.PhysicianStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.PhysicianStatus</span>
                                    }
                                </td>

                                <!-- Action Buttons -->
                                <td class="text-end">
                                    <a asp-action="EditPhysician"
                                       asp-route-id="@item.PhysicianId"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <a asp-action="GetPhysicianDetails"
                                       asp-route-id="@item.PhysicianId"
                                       class="btn btn-sm btn-outline-info me-1">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <a asp-action="DeletePhysician"
                                       asp-route-id="@item.PhysicianId"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
