@model CAS.Models.Chemist

<div class="container mt-4">
    <div class="card shadow-lg p-4">

        <h3>Edit Profile</h3>

        <form asp-action="Edit">

            <input type="hidden" asp-for="ChemistId" />

            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input asp-for="ChemistName" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Address</label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Summary</label>
                <textarea asp-for="Summary" class="form-control"></textarea>
            </div>

            <button type="submit" class="btn btn-success">
                Save Changes
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>
