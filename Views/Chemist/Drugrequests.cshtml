@model List<CAS.Models.DrugRequest>

@{
    ViewData["Title"] = "Physician Drug Requests";
    Layout = "~/Views/Shared/_LayoutRoles.cshtml";
}

<style>

    /* ================= PAGE BACKGROUND ================= */
    .requests-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= TABLE STYLING ================= */
    .request-table {
        background: rgba(255,255,255,0.97);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(0,0,0,0.35);
    }

        .request-table thead {
            background: linear-gradient(45deg,#0FA4AF,#024950);
            color: white;
        }

        .request-table th {
            padding: 16px;
            font-weight: 700;
            border: none;
        }

        .request-table td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(0,0,0,0.07);
            color: #003135;
        }

        .request-table tbody tr:hover {
            background: rgba(15,164,175,0.09);
        }

    /* ================= STATUS BADGES ================= */
    .status-badge {
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-pending {
        background: #ffc107;
        color: #000;
    }

    .status-approved {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
    }


    /* ================= BUTTONS ================= */
    .action-btn {
        border-radius: 30px;
        padding: 6px 16px;
        font-weight: 600;
        border: none;
        color: white;
        transition: 0.25s;
    }

    .btn-approve {
        background: linear-gradient(45deg,#0FA4AF,#024950);
    }

        .btn-approve:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(15,164,175,0.5);
        }


        .btn-reject:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(150,71,52,0.5);
        }

    /* ================= EMPTY ALERT ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        color: #AFDDE5;
        font-size: 20px;
    }

    .action-wrapper {
        display: flex;
        gap: 10px; /* Perfect spacing */
        justify-content: center; /* Center horizontally */
        align-items: center; /* Align vertically */
    }
</style>

<div class="requests-page">

    <div class="container">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title mb-0">Physician Drug Requests</h2>

            <a asp-controller="Chemist" asp-action="Index"
               class="btn btn-outline-light rounded-pill px-4 fw-semibold">
                ← Back
            </a>
        </div>

        <!-- EMPTY LIST -->
        @if (Model == null || !Model.Any())
        {
            <div class="custom-alert">
                <h5>No Requests Available</h5>
                <p>No physician drug requests found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table request-table align-middle">

                @foreach (var req in Model)
                {
                    string statusClass = req.RequestStatus == "Acknowledged" ? "status-approved"
                    : "status-pending";
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Physician ID</th>
                            <th>Date</th>
                            <th>Drug Info</th>
                            <th>Status</th>
                            <th style="width: 180px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var req in Model)
                        {
                            string statusClass = req.RequestStatus == "Approved" ? "status-approved"
                            : req.RequestStatus == "Rejected" ? "status-rejected"
                            : "status-pending";

                            <tr>
                                <td>@req.DrugRequestId</td>
                                <td>@req.PhysicianId</td>
                                <td>@req.RequestDate.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td>@req.DrugsInfoText</td>

                                <td>
                                    <span class="status-badge @statusClass">
                                        @req.RequestStatus
                                    </span>
                                </td>

                                <td>
                                    @if (req.RequestStatus == "Pending")
                                    {
                                        <div class="action-wrapper">
                                            <a asp-action="Approve"
                                               asp-route-id="@req.DrugRequestId"
                                               class="action-btn btn-approve">
                                                Approve
                                            </a>

                            <div class="mb-3">
                                <span class="info-label">Request Date:</span>
                                <div class="info-value">
                                    @req.RequestDate.ToString("dd MMM yyyy hh:mm tt")
                                </div>
                            </div>

                            <div class="mb-3">
                                <span class="info-label">Drug Details:</span>
                                <div class="info-value">
                                    @req.DrugsInfoText
                                </div>
                            </div>

                            <div class="mt-3">

                                <span class="status-badge @statusClass">
                                    @req.RequestStatus
                                </span>

                                @if (req.RequestStatus == "Pending")
                                {
                                    <div class="mt-3">
                                        <a asp-action="Approve"
                                           asp-route-id="@req.DrugRequestId"
                                           class="action-btn btn-approve">
                                            Acknowledge
                                        </a>
                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                }
                                            <a asp-action="Reject"
                                               asp-route-id="@req.DrugRequestId"
                                               class="action-btn btn-reject">
                                                Reject
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>

</div>