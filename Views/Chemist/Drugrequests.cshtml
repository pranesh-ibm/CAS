@model List<CAS.Models.DrugRequest>

@{
    ViewData["Title"] = "Physician Drug Requests";
    Layout = "~/Views/Shared/_LayoutRoles.cshtml";
}

<style>
    /* ================= BACKGROUND ================= */
    .requests-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= EMPTY STATE ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        color: #AFDDE5;
    }

    /* ================= TABLE WRAPPER ================= */
    .request-table-wrapper {
        background: rgba(255,255,255,0.95);
        padding: 30px;
        border-radius: 25px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.25);
        animation: fadeIn 0.6s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================= TABLE ================= */
    .request-table thead tr {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
    }

    .request-table th {
        padding: 14px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .request-table td {
        padding: 14px;
        color: #333;
        vertical-align: middle;
        font-size: 15px;
    }

    .request-table tbody tr {
        transition: 0.25s ease;
    }

        .request-table tbody tr:hover {
            background: rgba(15,164,175,0.08);
            transform: scale(1.01);
        }

    /* ================= STATUS BADGES ================= */
    .status-badge {
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-pending {
        background: #ffc107;
        color: #000;
    }

    .status-acknowledged {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
    }

    /* ================= ACTION BUTTON ================= */
    .action-btn-table {
        padding: 6px 14px;
        border-radius: 25px;
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white !important;
        font-weight: 600;
        border: none;
        transition: 0.3s ease;
        text-decoration: none;
    }

        .action-btn-table:hover {
            box-shadow: 0 0 15px rgba(15,164,175,0.6);
            transform: scale(1.05);
        }
</style>

<div class="requests-page">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <h2 class="page-title mb-0">Physician Drug Requests</h2>
            <a asp-controller="Chemist"
               asp-action="Index"
               class="btn btn-outline-light rounded-pill px-4 fw-semibold">
                ← Back
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="custom-alert">
                <h5 class="mb-3">No requests available</h5>
                <p>No physician drug requests found at this time.</p>
            </div>
        }
        else
        {
            <div class="table-responsive request-table-wrapper">
                <table class="table table-borderless align-middle request-table">
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Physician ID</th>
                            <th>Request Date</th>
                            <th>Drug Details</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var req in Model)
                        {
                            var statusClass = req.RequestStatus == "Acknowledged"
                            ? "status-acknowledged"
                            : "status-pending";

                            <tr>
                                <td>@req.DrugRequestId</td>
                                <td>@req.PhysicianId</td>
                                <td>@req.RequestDate.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td>@req.DrugsInfoText</td>

                                <td>
                                    <span class="status-badge @statusClass">
                                        @req.RequestStatus
                                    </span>
                                </td>

                                <td class="text-center">
                                    @if (req.RequestStatus == "Pending")
                                    {
                                        <a asp-action="Approve"
                                           asp-route-id="@req.DrugRequestId"
                                           class="action-btn-table">
                                            Acknowledge
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-semibold">✔ Done</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>