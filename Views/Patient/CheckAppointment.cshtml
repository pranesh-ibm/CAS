@{
    ViewData["Title"] = "Check Appointment";
    var list = ViewBag.Data as IEnumerable<dynamic>;
}

<style>

    /* ================= BACKGROUND ================= */
    .status-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= TABLE WRAPPER ================= */
    .status-table {
        background: rgba(255,255,255,0.97);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0,0,0,0.3);
    }

        .status-table thead {
            background: linear-gradient(45deg,#0FA4AF,#024950);
            color: white;
        }

        .status-table th {
            padding: 16px;
            font-size: 15px;
            font-weight: 700;
            border: none;
        }

        .status-table td {
            padding: 16px;
            vertical-align: middle;
            color: #003135;
            font-size: 15px;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .status-table tbody tr {
            transition: 0.25s ease;
        }

            .status-table tbody tr:hover {
                background: rgba(15,164,175,0.08);
            }

    /* ================= BADGES ================= */
    .badge-low {
        background: #198754;
    }

    .badge-medium {
        background: #ffc107;
        color: #000;
    }

    .badge-high {
        background: #dc3545;
    }

    .status-pending {
        background: #ffc107;
        color: #000;
    }

    .status-assigned {
        background: #0FA4AF;
    }

    .status-complete {
        background: #198754;
    }

    .datetime-badge {
        display: inline-block;
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
        padding: 6px 14px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 13px;
    }

    /* ================= ALERT ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        color: #AFDDE5;
        padding: 20px;
        text-align: center;
        font-size: 18px;
        max-width: 700px;
        margin: 0 auto;
    }

    .btn-back {
        background: linear-gradient(45deg,#124E66,#748D92);
        border-radius: 30px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: 0.4s;
    }

        .btn-back:hover {
            transform: translateY(-4px);
            box-shadow: 0 0 25px rgba(18,78,102,0.8);
        }

</style>

<div class="status-page">

    <div class="container">

        <div class="text-center mb-5">
            <h2 class="page-title">Appointment Status</h2>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="custom-alert mb-4">@ViewBag.Message</div>
        }

        @if (list != null && list.Any())
        {
            var data = list.ToList();

            <div class="table-responsive">
                <table class="table status-table align-middle">

                    <thead>
                        <tr>
                            <th>Criticality</th>
                            <th>Reason</th>
                            <th>Note</th>
                            <th>Physician</th>
                            <th>Date & Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in data)
                        {
                            string criticalityClass =
                            item.Criticality == "High" ? "badge-high" :
                            item.Criticality == "Medium" ? "badge-medium" :
                                                    "badge-low";

                            bool isPending = item.Status == "Yet to assign an appointment";

                            <tr>
                                <td>
                                    <span class="badge @criticalityClass">
                                        @item.Criticality
                                    </span>
                                </td>

                                <td>@item.Reason</td>
                                <td>@item.Note</td>

                                <td>
                                    @if (isPending)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        @item.PhysicianName
                                    }
                                </td>

                                <td>
                                    @if (isPending)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        <span class="datetime-badge">
                                            @item.ScheduleDate?.ToString("dd MMM yyyy") • @item.ScheduleTime?.ToString("hh:mm tt")
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="badge @(isPending ? "status-pending" : "status-assigned")">
                                        @item.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="custom-alert">No appointment data found.</div>
        }

        <div class="text-center mt-4">
            <a asp-action="Index" class="btn btn-back">Back</a>
        </div>

    </div>

</div>