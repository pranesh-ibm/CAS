@{
    ViewData["Title"] = "Check Appointment";
    var list = ViewBag.Data;
}

<style>

    /* ================= BACKGROUND ================= */
    .status-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= CARD ================= */
    .status-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 35px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.25);
        transition: 0.35s ease;
        position: relative;
        overflow: hidden;
    }

        .status-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 35px 70px rgba(0,0,0,0.3);
        }

        /* Accent strip */
        .status-card::before {
            content: "";
            position: absolute;
            height: 6px;
            width: 100%;
            top: 0;
            left: 0;
            background: linear-gradient(45deg,#0FA4AF,#964734);
        }

    /* ================= SECTION TITLE ================= */
    .section-title {
        font-weight: 700;
        color: #124E66;
        margin-bottom: 15px;
    }

    /* ================= LABEL STYLING ================= */
    .info-label {
        font-weight: 600;
        color: #003135;
    }

    .info-value {
        color: #555;
        margin-bottom: 10px;
    }

    /* ================= CRITICALITY BADGES ================= */
    .badge-low {
        background: #198754;
    }

    .badge-medium {
        background: #ffc107;
        color: #000;
    }

    .badge-high {
        background: #dc3545;
    }

    /* ================= STATUS BADGES ================= */
    .status-pending {
        background: #ffc107;
        color: #000;
    }

    .status-assigned {
        background: #0FA4AF;
    }

    .status-complete {
        background: #198754;
    }

    /* ================= DATE BADGE ================= */
    .datetime-badge {
        display: inline-block;
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        margin-top: 10px;
    }

    /* ================= ALERT ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        color: #AFDDE5;
        padding: 20px;
        text-align: center;
    }

</style>

<div class="status-page">

    <div class="container">

        <div class="text-center mb-5">
            <h2 class="page-title">Appointment Status</h2>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="custom-alert mb-4">
                @ViewBag.Message
            </div>
        }

        @if (list != null)
        {
            var data = ((IEnumerable<dynamic>)list).ToList();
            var count = data.Count;

            <div class="row g-4 @(count == 1 ? "justify-content-center" : "")">

                @foreach (var item in data)
                {
                    string criticalityClass = item.Criticality == "High" ? "badge-high"
                    : item.Criticality == "Medium" ? "badge-medium"
                    : "badge-low";

                    bool isPending = item.Status == "Yet to assign an appointment";

                    <div class="@(count == 1 ? "col-lg-6 col-md-8" : "col-lg-6")">

                        <div class="status-card h-100">

                            <div class="section-title">
                                📅 Appointment Details
                            </div>

                            <div class="mb-2">
                                <span class="info-label">Criticality:</span>
                                <span class="badge @criticalityClass">
                                    @item.Criticality
                                </span>
                            </div>

                            <div class="info-value">
                                <span class="info-label">Reason:</span> @item.Reason
                            </div>

                            <div class="info-value">
                                <span class="info-label">Note:</span> @item.Note
                            </div>

                            <hr />

                            @if (isPending)
                            {
                                <span class="badge status-pending">
                                    @item.Status
                                </span>
                            }
                            else
                            {
                                <div class="info-value">
                                    <span class="info-label">Physician:</span>
                                    @item.PhysicianName
                                </div>

                                <div class="datetime-badge">
                                    @item.ScheduleDate?.ToString("dd MMM yyyy")
                                    •
                                    @item.ScheduleTime?.ToString("hh:mm tt")
                                </div>

                                <div class="mt-3">
                                    <span class="badge status-assigned">
                                        @item.Status
                                    </span>
                                </div>
                            }

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>
