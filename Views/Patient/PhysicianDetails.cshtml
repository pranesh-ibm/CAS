@model List<CAS.Models.Physician>
@{
    var distinctPhysicians = Model
        .GroupBy(p => p.PhysicianName)
        .Select(g => g.First())
        .ToList();
}

@{
    ViewData["Title"] = "Physician Details";
}

<style>

    /* ================= PAGE BACKGROUND ================= */
    .physician-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    
    /* ================= NAME ================= */
    .physician-name {
        color: #024950;
        font-weight: 700;
        margin-bottom: 10px;
    }

    /* ================= INFO LABEL ================= */
    .info-label {
        font-weight: 600;
        color: #003135;
    }

    .info-value {
        color: #555;
    }

    /* ================= STATUS BADGE ================= */
    .status-badge {
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-active {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
    }

    .status-inactive {
        background: #964734;
        color: white;
    }

    /* ================= ALERT ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        color: #AFDDE5;
        padding: 20px;
        text-align: center;
    }

    .btn-back {
        background: linear-gradient(45deg,#124E66,#748D92);
        border-radius: 30px;
        padding: 12px 30px;
        color: white;
        font-weight: 600;
        transition: 0.4s;
    }

        .btn-back:hover {
            transform: translateY(-4px);
            box-shadow: 0 0 25px rgba(18,78,102,0.8);
        }
    /* ================= GRID VIEW =============== */
    .physician-table {
        background: rgba(255,255,255,0.95);
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }

        .physician-table thead {
            background: linear-gradient(45deg,#024950,#0FA4AF);
            color: #ffffff;
        }

            .physician-table thead th {
                padding: 16px;
                font-size: 15px;
                font-weight: 700;
                border: none;
            }

        .physician-table tbody tr {
            transition: 0.25s ease;
        }

        .physician-table tbody td {
            padding: 16px;
            color: #003135;
        }

        .physician-table tbody tr:hover {
            background: rgba(15,164,175,0.08);
            transform: scale(1.01);
        }

    /* Status Badges (reuse ones already created) */
    .status-badge {
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-active {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
    }

    .status-inactive {
        background: #964734;
        color: white;
    }
</style>

<div class="physician-page">

    <div class="container">

        <!-- HEADER -->
        <div class="text-center mb-5">
            <h2 class="page-title">Physician Directory</h2>
            <p class="text-white-50">
                View physician profiles, specialization & contact details
            </p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="custom-alert mb-4">
                @ViewBag.Message
            </div>
        }

        @if (distinctPhysicians.Any())
        {
            <div class="table-responsive mt-4">
                <table class="table physician-table align-middle">

                    <thead>
                        <tr>
                            <th>Physician</th>
                            <th>Specialization</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var p in distinctPhysicians)
                        {
                            var isActive = p.PhysicianStatus == "Active";

                            <tr>
                                <td>
                                    <strong>@p.PhysicianName</strong><br />
                                    <small class="text-muted">@p.Address</small>
                                </td>
                                <td>@p.Specialization</td>
                                <td>@p.Email</td>
                                <td>@p.Phone</td>
                                <td>
                                    <span class="status-badge @(isActive ? "status-active" : "status-inactive")">
                                        @p.PhysicianStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        <div class="text-center mt-4 d-flex justify-content-center gap-3">
         
            <a asp-action="Index" class="btn btn-edit btn-back">
                Back
            </a>
        </div>

    </div>

</div>
