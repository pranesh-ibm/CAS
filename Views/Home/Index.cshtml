@model List<CAS.Models.Drug>
@{
    ViewData["Title"] = "MedAxis";
}

<style>
    /* ================= GLOBAL ================= */
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient( 135deg, #212A31, #2E3944, #124E66 );
        background-size: 300% 300%;
        animation: gradientMove 12s ease infinite;
        min-height: 100vh;
        color: #ffffff;
    }

    @@keyframes gradientMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HERO ================= */
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 80px 20px;
        position: relative;
    }

        /* Optional background image space */
        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( rgba(33,42,49,0.85), rgba(18,78,102,0.85) ), url('/images/clinic.jpg'); /* Optional */
            background-size: cover;
            background-position: center;
            z-index: 0;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    /* ================= TEXT VISIBILITY FIX ================= */
    .hero h1 {
        font-size: 4rem;
        font-weight: 700;
        color: #D3D9D4;
        text-shadow: 0 4px 20px rgba(0,0,0,0.7);
        animation: fadeDown 1s ease;
    }

    .hero p {
        font-size: 1.3rem;
        color: #ffffff;
        text-shadow: 0 3px 15px rgba(0,0,0,0.6);
        animation: fadeUp 1.2s ease;
    }

    /* ================= AUTH BUTTONS ================= */
    /* ================= AUTH BUTTONS (Upgraded Modern Neon Style) ================= */

    /* ================= SLEEK MODERN BUTTONS ================= */

    .auth-buttons {
        display: flex;
        justify-content: center;
        margin-top: 30px;
        gap: 14px;
    }

    .btn-login,
    .btn-register {
        padding: 12px 30px;
        border-radius: 12px;
        font-size: 1.05rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.28s ease;
        border: none;
        letter-spacing: 0.3px;
    }

    /* Sleek solid button */
    .btn-login {
        background: #66FCF1;
        color: #0B0C10;
        box-shadow: 0 3px 10px rgba(0,0,0,0.18);
    }

        .btn-login:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.22);
        }

    /* Clean outlined button */
    .btn-register {
        background: transparent;
        color: #ffffff;
        border: 2px solid rgba(255,255,255,0.6);
    }

        .btn-register:hover {
            background: rgba(255,255,255,0.15);
            border-color: #ffffff;
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.25);
        }


    /* ================= ROLE CARDS ================= */
    /* ============= MODERN ROLE CARDS (Upgraded) ============= */
    .role-card {
        background: linear-gradient(145deg, #1B2A35, #0F1C24);
        border-radius: 25px;
        padding: 35px 25px;
        color: #EAF6F6;
        text-align: center;
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 8px 25px rgba(0,0,0,0.35), 0 0 0 0 rgba(102,252,241,0.25); /* glow ring animation base */

        transition: 0.45s ease;
        opacity: 0;
        transform: translateY(40px);
        animation: cardFloatUp 1s ease forwards;
    }

        .role-card:nth-child(1) {
            animation-delay: 0.2s;
        }

        .role-card:nth-child(2) {
            animation-delay: 0.4s;
        }

        .role-card:nth-child(3) {
            animation-delay: 0.6s;
        }

        .role-card h4 {
            font-weight: 700;
            font-size: 1.4rem;
            color: #66FCF1;
        }

        .role-card p {
            font-size: 1.1rem;
            line-height: 1.5;
            color: #C5C6C7;
        }

        /* Hover Effect: Glow + Lift + Slight Scale */
        .role-card:hover {
            transform: translateY(-15px) scale(1.04);
            box-shadow: 0 15px 35px rgba(0,0,0,0.5), 0 0 22px 6px rgba(102,252,241,0.45);
        }

    /* Smooth float-up animation */
    @@keyframes cardFloatUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================= FEATURES SECTION ================= */
    .features-section {
        background: linear-gradient( 135deg, #748D92, #D3D9D4 );
        padding: 80px 0;
        color: #212A31;
    }

    .feature-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        transition: 0.4s;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

        .feature-card h4 {
            color: #124E66;
        }

        .feature-card p {
            color: #2E3944;
        }

        .feature-card:hover {
            transform: translateY(-10px);
        }

    /* ================= WORKFLOW ================= */
    .workflow {
        background: linear-gradient( 90deg, #124E66, #212A31 );
        color: #ffffff;
        padding: 80px 0;
    }

        .workflow h2,
        .workflow h5,
        .workflow p {
            color: #ffffff;
        }

    /* ================= FOOTER ================= */
    .footer {
        background-color: #212A31;
        color: #D3D9D4;
        padding: 40px 0;
    }

        .footer h5 {
            color: #ffffff;
        }

    /* ================= ANIMATIONS ================= */
    @@keyframes fadeDown {
        from {
            opacity: 0;
            transform: translateY(-40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .inventory-page {
        background: linear-gradient(135deg,#212A31,#2E3944,#124E66);
        background-size: 300% 300%;
        animation: bgMove 12s ease infinite;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= CARD CONTAINER ================= */
    .inventory-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
        animation: fadeUp 0.8s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .inventory-title {
        font-weight: 700;
        color: #212A31;
    }

    /* ================= TABLE STYLING ================= */
    .table {
        border-radius: 15px;
        overflow: hidden;
    }

        .table thead {
            background: linear-gradient(45deg,#124E66,#748D92);
            color: white;
        }

            .table thead th {
                border: none;
                padding: 15px;
            }

        .table tbody td {
            padding: 15px;
            vertical-align: middle;
        }

        .table tbody tr {
            transition: 0.3s;
        }

            .table tbody tr:hover {
                background-color: rgba(18,78,102,0.08);
                transform: scale(1.01);
            }

    /* ================= BADGES ================= */
    .badge-expiry {
        background: linear-gradient(45deg,#124E66,#748D92);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .badge-warning {
        background: #dc3545;
    }

    /* ================= RESPONSIVE ================= */
    @@media(max - width:768px) {
        .inventory-card {
            padding: 20px;
        }
    }

  

</style>

<!-- AUTH BUTTONS -->


<!-- HERO -->
<div class="hero">
    <div class="container hero-content text-center">
        <h1>MedAxis</h1>
        <p>Next-Generation Clinical Automation Platform</p>
        <div class="auth-buttons">
            <a asp-controller="CrediMgr" asp-action="Login" class="btn btn-login">Login</a>
            <a asp-controller="CrediMgr" asp-action="RegisterPatient" class="btn btn-register">Register</a>
        </div>
        <div class="row mt-5 justify-content-center">
            <div class="col-md-3 m-3 role-card">
                <h4>Physician</h4>
                <p>Digital prescriptions & patient scheduling.</p>
            </div>
            <div class="col-md-3 m-3 role-card">
                <h4>Chemist</h4>
                <p>Smart inventory & procurement workflow.</p>
            </div>
            <div class="col-md-3 m-3 role-card">
                <h4>Supplier</h4>
                <p>Automated order approval & logistics.</p>
            </div>
        </div>
    </div>
</div>

<!-- FEATURES -->
<div class="features-section text-center">
    <div class="container">
        <h2 class="mb-5">About MedAxis</h2>
        <p class="mb-5 text-muted">
            MedAxis is an integrated healthcare automation system designed to connect
            physicians, chemists, and suppliers within a unified digital workflow.
            It eliminates manual inefficiencies and enhances operational transparency.
        </p>

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="feature-card">
                    <h4>Appointment Management</h4>
                    <p>Secure and streamlined patient scheduling system.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card">
                    <h4>Digital Prescription Tracking</h4>
                    <p>Real-time tracking between physician and chemist.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card">
                    <h4>Procurement Automation</h4>
                    <p>End-to-end supplier approval & inventory updates.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="inventory-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="inventory-card">

                    <h2 class="inventory-title mb-4 text-center">
                        Drug Inventory
                    </h2>

                    <div class="table-responsive">
                        <table class="table align-middle">

                            <thead>
                                <tr>
                                    <th>Drug Name</th>
                                    <th>Description</th>
                                    <th>Dosage</th>
                                    <th>Expiry</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.DrugTitle</td>

                                        <td>@item.Description</td>

                                        <td>
                                            <span class="badge-expiry">
                                                @item.Dosage
                                            </span>
                                        </td>

                                        <td>
                                            @{
                                                var isExpired = item.Expiry.HasValue &&
                                                item.Expiry.Value < DateOnly.FromDateTime(DateTime.Now);

                                            }

                                            <span class="badge-expiry @(isExpired ? "badge-warning" : "")">
                                                @item.Expiry?.ToString("dd MMM yyyy")

                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<!-- WORKFLOW -->
<div class="workflow text-center">
    <div class="container">
        <h2 class="mb-5">System Workflow</h2>
        <div class="row">
            <div class="col-md-3 workflow-step">
                <h5>1️⃣ Physician</h5>
                <p>Create digital prescription</p>
            </div>
            <div class="col-md-3 workflow-step">
                <h5>2️⃣ Chemist</h5>
                <p>Manage inventory & place order</p>
            </div>
            <div class="col-md-3 workflow-step">
                <h5>3️⃣ Supplier</h5>
                <p>Approve / Reject purchase</p>
            </div>
            <div class="col-md-3 workflow-step">
                <h5>4️⃣ MedAxis</h5>
                <p>Auto-update system & reports</p>
            </div>
        </div>
    </div>
</div>

