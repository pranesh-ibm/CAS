@model CAS.Models.ViewModel.PhysicianProfileViewModel
@{
    ViewData["Title"] = "Physician Dashboard";
    var username = User.Identity?.Name ?? Model.PhysicianName ?? "Physician";
}

<style>
    .gradient-header {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .action-card {
        border-radius: 15px;
        transition: 0.3s ease;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

    .action-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.15);
    }

    .btn-modern {
        border-radius: 25px;
        padding: 8px 20px;
        font-weight: 500;
    }
</style>

<div class="container mt-4">

    <div class="gradient-header text-center mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-0">Welcome, @username 👋</h2>
                <p class="mb-0">Physician Dashboard</p>
            </div>
            <div class="text-end">
                <a asp-action="EditProfile" class="btn btn-outline-light">Edit Profile</a>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card p-3 profile-card h-100">
                <h5 class="mb-1">@Model.PhysicianName</h5>
                <small class="text-muted">@Model.Specialization</small>
                <p class="mt-3 mb-1"><strong>Email:</strong> @Model.Email</p>
                <p class="mb-1"><strong>Phone:</strong> @Model.Phone</p>
                <p class="mb-0 text-truncate"><strong>Address:</strong> @Model.Address</p>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card p-3 h-100">
                <h6>Summary</h6>
                <p class="text-muted">@Model.Summary</p>
            </div>
        </div>
    </div>

    <div class="row text-center">

        <div class="col-md-4 mb-4">
            <div class="card action-card p-4 h-100">
                <h5>🧑‍⚕️ View Patients</h5>
                <p class="text-muted">Browse and search your patients</p>
                <a asp-controller="Physician" asp-action="ViewPatients" class="btn btn-primary btn-modern">Open</a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card action-card p-4 h-100">
                <h5>✍️ Create Prescription</h5>
                <p class="text-muted">Compose a new prescription</p>
                <a asp-controller="Physician" asp-action="CreatePrescription" class="btn btn-success btn-modern">Create</a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card action-card p-4 h-100">
                <h5>📄 View Prescriptions</h5>
                <p class="text-muted">See prescriptions you've issued</p>
                <a asp-controller="Physician" asp-action="ViewPrescriptions" class="btn btn-dark btn-modern">View</a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card action-card p-4 h-100">
                <h5>📅 View Appointments</h5>
                <p class="text-muted">Manage your appointment schedule</p>
                <a asp-controller="Physician" asp-action="ViewAppointments" class="btn btn-info btn-modern">Open</a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card action-card p-4 h-100">
                <h5>💊 View Drugs</h5>
                <p class="text-muted">Browse available drugs</p>
                <a asp-controller="Physician" asp-action="ViewDrugs" class="btn btn-warning btn-modern">Browse</a>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card action-card p-4 h-100">
                <h5>🛒 Order Drugs</h5>
                <p class="text-muted">Place drug requests</p>
                <a asp-controller="Physician" asp-action="OrderDrugs" class="btn btn-danger btn-modern">Order</a>
            </div>
        </div>

    </div>

</div>
