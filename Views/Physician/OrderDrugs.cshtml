@model CAS.Models.ViewModel.OrderDrugsViewModel

@{
    ViewData["Title"] = "Order Drugs";
}

<style>

    /* ================= BACKGROUND ================= */
    .appointment-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= CARD ================= */
    .appointment-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.3);
        animation: fadeUp 0.8s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= FORM CONTROLS ================= */
    .form-label {
        font-weight: 600;
        color: #024950;
    }

    .form-control {
        border-radius: 30px;
        padding: 12px 20px;
        border: 2px solid #eaeaea;
        transition: 0.3s ease;
    }

        .form-control:focus {
            border-color: #0FA4AF;
            box-shadow: 0 0 15px rgba(15,164,175,0.4);
        }

    /* ================= BUTTON ================= */
    .btn-premium {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        border: none;
        border-radius: 30px;
        padding: 14px;
        font-weight: 600;
        color: white;
        transition: 0.3s ease;
    }

        .btn-premium:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(15,164,175,0.6);
            color: white;
        }

</style>

<div class="appointment-page">

    <div class="container">

        <div class="text-center mb-5">
            <h2 class="page-title">Order Drugs</h2>
            <p class="text-white-50">
                Submit your drug requirements easily
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">

                <div class="appointment-card">

                    <form id="orderDrugsForm"
                          asp-action="OrderDrugs"
                          method="post"
                          novalidate>

                        @Html.AntiForgeryToken()
                        <div id="orderDrugsSummary"
                             class="text-danger mb-4 text-center"></div>

                        <!-- Drug Info -->
                        <div class="mb-4">
                            <label class="form-label">Drug Details</label>
                            <textarea name="DrugsInfoText"
                                      class="form-control"
                                      rows="4"
                                      required>@Model.Form.DrugsInfoText</textarea>
                            <div class="invalid-feedback">
                                This field is required
                            </div>
                        </div>

                        <!-- Submit -->
                        <button type="button"
                                id="orderDrugsBtn"
                                class="btn btn-premium w-100">
                            Submit Order
                        </button>

                    </form>

                </div>

            </div>
        </div>

    </div>

</div>
