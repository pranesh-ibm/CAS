@model CAS.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<style>

    /* ================= PAGE BACKGROUND ================= */
    .patient-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= PATIENT CARD ================= */
    .patient-card {
        background: rgba(255,255,255,0.95);
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        transition: all 0.35s ease;
        position: relative;
        overflow: hidden;
    }

        .patient-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 70px rgba(0,0,0,0.25);
        }

        .patient-card::before {
            content: "";
            position: absolute;
            height: 5px;
            width: 100%;
            top: 0;
            left: 0;
            background: linear-gradient(45deg,#0FA4AF,#964734);
        }

    /* ================= NAME ================= */
    .patient-name {
        color: #024950;
        font-weight: 700;
        margin-bottom: 10px;
    }

    /* ================= INFO LABEL ================= */
    .info-label {
        font-weight: 600;
        color: #003135;
    }

    .info-value {
        color: #555;
    }

    /* ================= STATUS BADGE ================= */
    .status-badge {
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-active {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
    }

    .status-inactive {
        background: #964734;
        color: white;
    }

    /* ================= BUTTON ================= */
    .dashboard-btn-outline {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 30px;
        border: 2px solid #964734;
        color: #964734;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .dashboard-btn-outline:hover {
            background: #964734;
            color: white;
            transform: scale(1.05);
        }

</style>

<div class="patient-page">

    <div class="container">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h2 class="page-title mb-0">Patient Details</h2>
            <a asp-action="ViewPatients" class="dashboard-btn-outline">
                Back to Patients
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">

                @{
                    var isActive = Model.PatientStatus == "Active";
                }

                <div class="patient-card">

                    <h4 class="patient-name">
                        👤 @Model.PatientName
                    </h4>

                    <p>
                        <span class="info-label">Phone:</span>
                        <span class="info-value">@(Model.Phone ?? "-")</span>
                    </p>

                    <p>
                        <span class="info-label">Email:</span>
                        <span class="info-value">@(Model.Email ?? "-")</span>
                    </p>

                    <p>
                        <span class="info-label">DOB:</span>
                        <span class="info-value">
                            @(Model.Dob?.ToString("dd MMM yyyy") ?? "-")
                        </span>
                    </p>

                    <p>
                        <span class="info-label">Gender:</span>
                        <span class="info-value">@(Model.Gender ?? "-")</span>
                    </p>

                    <p>
                        <span class="info-label">Address:</span>
                        <span class="info-value">@(Model.Address ?? "-")</span>
                    </p>

                    <p>
                        <span class="info-label">Summary:</span>
                        <span class="info-value">@(Model.Summary ?? "-")</span>
                    </p>

                    <div class="mt-3">
                        <span class="status-badge @(isActive ? "status-active" : "status-inactive")">
                            @(Model.PatientStatus ?? "-")
                        </span>
                    </div>

                </div>

            </div>
        </div>

    </div>

</div>
