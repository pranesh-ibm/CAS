@model CAS.Models.ViewModel.CreatePrescriptionViewModel

@{
    ViewData["Title"] = "Create Prescription";
}

<style>

    /* ================= BACKGROUND ================= */
    .appointment-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= CARD ================= */
    .appointment-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.3);
        animation: fadeUp 0.8s ease;
    }

    .inventory-title {
        font-weight: 700;
        color: #124E66;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================= FORM CONTROLS ================= */
    .form-label {
        font-weight: 600;
        color: #024950;
    }

    .form-control,
    .form-select {
        border-radius: 30px;
        padding: 12px 20px;
        border: 2px solid #eaeaea;
        transition: 0.3s ease;
        height: 48px;
        box-sizing: border-box;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0FA4AF;
            box-shadow: 0 0 15px rgba(15,164,175,0.4);
        }

    /* ================= DYNAMIC ROWS (match Chemist OrderDrug layout) ================= */
    .item-row .form-control,
    .item-row textarea.form-control {
        height: 48px;
        padding-top: 8px;
        padding-bottom: 8px;
    }

    /* Equal height for button */
    .item-row .remove-btn {
        height: 48px;
    }

    /* Ensure Dosage placeholder is fully visible */
    .item-row .dosage-input {
        min-width: 110px;
    }

    .remove-btn {
        background: #dc3545;
        border: none;
        border-radius: 30px;
        font-weight: 600;
        color: white;
        transition: 0.25s ease;
    }

    .remove-btn:hover {
        background: #b02a37;
        transform: scale(1.05);
        box-shadow: 0 0 18px rgba(220,53,69,0.5);
    }

    /* ================= BUTTON ================= */
    .btn-premium {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        border: none;
        border-radius: 30px;
        padding: 14px;
        font-weight: 600;
        color: white;
        transition: 0.3s ease;
    }

        .btn-premium:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(15,164,175,0.6);
            color: white;
        }

    .dashboard-btn-outline {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 30px;
        border: 2px solid #964734;
        color: #964734;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .dashboard-btn-outline:hover {
            background: #964734;
            color: white;
            transform: scale(1.05);
        }

</style>

<div class="appointment-page">

    <div class="container">

        

        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">

                <div class="appointment-card">

                    <div class="d-flex align-items-center mb-4">
                        <a asp-action="Index" class="dashboard-btn-outline me-3">Back</a>
                        <div>
                            <h2 class="inventory-title mb-1">Create Prescription</h2>
                        </div>
                    </div>

                    <form id="createPrescForm"
                          asp-action="CreatePrescription"
                          method="post"
                          novalidate>

                        @Html.AntiForgeryToken()
                        <div id="createPrescSummary" class="text-danger mb-4 text-center"></div>

                        <!-- Schedule -->
                        <div class="mb-4">
                            <label class="form-label">Schedule (Patient & Date)</label>
                            <select name="ScheduleId" class="form-select" required>
                                <option value="">-- Select --</option>
                                @foreach (var s in Model.Schedules)
                                {
                                    <option value="@s.ScheduleId">@s.Appointment.Patient.PatientName - @s.ScheduleDate.ToString("dd MMM yyyy")</option>
                                }
                            </select>
                            <div class="invalid-feedback">This field is required</div>
                        </div>

                        <hr class="mb-4" />

                        <h5 class="mb-3 fw-bold text-dark">Add Drugs</h5>

                        <div id="items-container">

                            <div class="row mb-4 item-row align-items-end">

                                <div class="col-md-3">
                                    <select name="DrugIds" class="form-control" required>
                                        <option value="">-- Select Drug --</option>
                                        @foreach (var d in Model.Drugs)
                                        {
                                            <option value="@d.DrugId">@d.DrugTitle</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-5">
                                    <textarea name="PrescriptionTexts" class="form-control" rows="1" style="resize: none; height:48px;" placeholder="Prescription details" required></textarea>
                                </div>

                                <div class="col-md-2">
                                    <input name="Dosages" class="form-control dosage-input" type="text" placeholder="Dosage" required />
                                </div>

                                <div class="col-md-2">
                                    <button type="button" class="btn remove-btn w-100 ms-3">Remove</button>
                                </div>

                            </div>

                        </div>

                        <div class="text-center mb-4">
                            <button type="button" class="btn btn-outline-premium" id="add-item">+ Add Another Medicine</button>
                        </div>

                        <!-- Advice -->
                        <div class="mb-4">
                            <label class="form-label">Advice</label>
                            <textarea name="Advice"
                                      class="form-control"
                                      rows="3"
                                      required></textarea>
                            <div class="invalid-feedback">This field is required</div>
                        </div>

                        <!-- Note -->
                        <div class="mb-4">
                            <label class="form-label">Note</label>
                            <textarea name="Note"
                                      class="form-control"
                                      rows="3"
                                      required></textarea>
                            <div class="invalid-feedback">This field is required</div>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                id="createPrescBtn"
                                class="btn btn-premium w-100">
                            Create Prescription
                        </button>

                    </form>

                </div>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        (function(){
            var selected = '@(Model.SelectedScheduleId?.ToString() ?? "")';
            if (selected) {
                var sel = document.querySelector('select[name="ScheduleId"]');
                if (sel) sel.value = selected;
            }

            var container = document.getElementById('items-container');
            var addBtn = document.getElementById('add-item');

            function createNewRow() {
                if (!container) return;
                var firstRow = document.querySelector('.item-row');
                if (!firstRow) return;
                var newRow = firstRow.cloneNode(true);

                newRow.querySelectorAll('input, textarea').forEach(function (el) { el.value = ''; });
                newRow.querySelectorAll('select').forEach(function (el) { el.selectedIndex = 0; });

                container.appendChild(newRow);
            }

            if (addBtn) {
                addBtn.addEventListener('click', function () {
                    createNewRow();
                });
            }

            // Use event delegation for remove buttons
            document.addEventListener('click', function (e) {
                var target = e.target;
                if (target && target.classList.contains('remove-btn')) {
                    var rows = document.querySelectorAll('.item-row');
                    if (rows.length > 1) {
                        var row = target.closest('.item-row');
                        if (row) row.remove();
                    }
                }
            });

        })();
    </script>
}
