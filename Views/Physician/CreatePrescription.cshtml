@model CAS.Models.ViewModel.CreatePrescriptionViewModel

@{
    ViewData["Title"] = "Create Prescription";
}

<style>

    /* ================= BACKGROUND ================= */
    .appointment-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= CARD ================= */
    .appointment-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.3);
        animation: fadeUp 0.8s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================= FORM CONTROLS ================= */
    .form-label {
        font-weight: 600;
        color: #024950;
    }

    .form-control,
    .form-select {
        border-radius: 30px;
        padding: 12px 20px;
        border: 2px solid #eaeaea;
        transition: 0.3s ease;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0FA4AF;
            box-shadow: 0 0 15px rgba(15,164,175,0.4);
        }

    /* ================= BUTTON ================= */
    .btn-premium {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        border: none;
        border-radius: 30px;
        padding: 14px;
        font-weight: 600;
        color: white;
        transition: 0.3s ease;
    }

        .btn-premium:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(15,164,175,0.6);
            color: white;
        }

</style>

<div class="appointment-page">

    <div class="container">

        <div class="d-flex align-items-center mb-5">
            <a asp-action="Index" class="dashboard-btn-outline me-3">Back</a>
            <div>
                <h2 class="page-title mb-0">Create Prescription</h2>
                <p class="text-white-50 mb-0">Generate prescription details for scheduled patients</p>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">

                <div class="appointment-card">

                    <form id="createPrescForm"
                          asp-action="CreatePrescription"
                          method="post"
                          novalidate>

                        @Html.AntiForgeryToken()
                        <div id="createPrescSummary" class="text-danger mb-4 text-center"></div>

                        <!-- Schedule -->
                        <div class="mb-4">
                            <label class="form-label">Schedule (Patient & Date)</label>
                            <select name="ScheduleId" class="form-select" required>
                                <option value="">-- Select --</option>
                                @foreach (var s in Model.Schedules)
                                {
                                    <option value="@s.ScheduleId">
                                        @s.Appointment.Patient.PatientName -
                                        @s.ScheduleDate.ToString("dd MMM yyyy")
                                    </option>
                                }
                            </select>
                            <div class="invalid-feedback">This field is required</div>
                        </div>

                        <!-- Drug -->
                        <div class="mb-4">
                            <label class="form-label">Drug</label>
                            <select name="DrugId" class="form-select" required>
                                <option value="">-- Select Drug --</option>
                                @foreach (var d in Model.Drugs)
                                {
                                    <option value="@d.DrugId">@d.DrugTitle</option>
                                }
                            </select>
                            <div class="invalid-feedback">This field is required</div>
                        </div>

                        <!-- Prescription -->
                        <div class="mb-4">
                            <label class="form-label">Prescription Details</label>
                            <textarea name="Prescription"
                                      class="form-control"
                                      rows="3"
                                      required></textarea>
                            <div class="invalid-feedback">This field is required</div>
                        </div>

                        <!-- Dosage -->
                        <div class="mb-4">
                            <label class="form-label">Dosage</label>
                            <input name="Dosage"
                                   class="form-control"
                                   required />
                            <div class="invalid-feedback">This field is required</div>
                        </div>

                        <!-- Advice -->
                        <div class="mb-4">
                            <label class="form-label">Advice</label>
                            <textarea name="Advice"
                                      class="form-control"
                                      rows="3"
                                      required></textarea>
                            <div class="invalid-feedback">This field is required</div>
                        </div>

                        <!-- Note -->
                        <div class="mb-4">
                            <label class="form-label">Note</label>
                            <textarea name="Note"
                                      class="form-control"
                                      rows="3"
                                      required></textarea>
                            <div class="invalid-feedback">This field is required</div>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                id="createPrescBtn"
                                class="btn btn-premium w-100">
                            Create Prescription
                        </button>

                    </form>

                </div>

            </div>
        </div>

    </div>

</div>
