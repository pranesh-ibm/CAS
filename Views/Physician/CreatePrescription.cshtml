@model CAS.Models.ViewModel.CreatePrescriptionViewModel

@{
    ViewData["Title"] = "Create Prescription";
}

<h2>Create Prescription</h2>

<form id="createPrescForm" asp-action="CreatePrescription" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div id="createPrescSummary" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label class="form-label">Schedule (Patient & Date)</label>
        <select name="ScheduleId" class="form-select" required>
            <option value="">-- Select --</option>
            @foreach (var s in Model.Schedules)
            {
                <option value="@s.ScheduleId">@s.Appointment.Patient.PatientName - @s.ScheduleDate.ToString()</option>
            }
        </select>
        <div class="invalid-feedback">This field is required</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Drug</label>
        <select name="DrugId" class="form-select" required>
            <option value="">-- Select Drug --</option>
            @foreach (var d in Model.Drugs)
            {
                <option value="@d.DrugId">@d.DrugTitle</option>
            }
        </select>
        <div class="invalid-feedback">This field is required</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Prescription Details</label>
        <textarea name="Prescription" class="form-control" required></textarea>
        <div class="invalid-feedback">This field is required</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Dosage</label>
        <input name="Dosage" class="form-control" required />
        <div class="invalid-feedback">This field is required</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Advice</label>
        <textarea name="Advice" class="form-control" required></textarea>
        <div class="invalid-feedback">This field is required</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Note</label>
        <textarea name="Note" class="form-control" required></textarea>
        <div class="invalid-feedback">This field is required</div>
    </div>

    <button type="button" id="createPrescBtn" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Bootstrap style validation: add/remove is-invalid class
        (function () {
            var form = document.getElementById('createPrescForm');
            var btn = document.getElementById('createPrescBtn');
            var summary = document.getElementById('createPrescSummary');
            if (!form || !btn) return;

            btn.addEventListener('click', function(e){
                e.preventDefault();
                summary.innerText = '';

                if (!validateForm(form)) return;

                (async function(){
                    try {
                        var fd = new FormData(form);
                        var res = await fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: fd });
                        if (!res.ok) {
                            var err = 'An error occurred while creating prescription.';
                            try { var body = await res.json(); if (body && body.message) err = body.message; } catch(e){}
                            summary.innerText = err;
                            return;
                        }
                        var json = await res.json();
                        if (json && json.success) {
                            showModalAndRedirect(json.message || 'Prescription created', '@Url.Action("Index", "Physician")');
                            return;
                        }
                        summary.innerText = (json && json.message) ? json.message : 'Unexpected response.';
                    } catch (ex) {
                        summary.innerText = 'Network error while creating prescription.';
                    }
                })();
            });

            function showModalAndRedirect(message, url) {
                var modalId = 'ajaxSuccessModalPresc';
                var existing = document.getElementById(modalId);
                if (existing) existing.remove();

                var html = '<div class="modal fade" id="' + modalId + '" tabindex="-1" aria-hidden="true">' +
                    '<div class="modal-dialog modal-dialog-centered"><div class="modal-content">' +
                    '<div class="modal-header"><h5 class="modal-title">Success</h5>' +
                    '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>' +
                    '<div class="modal-body">' + encodeHtml(message) + '</div>' +
                    '<div class="modal-footer"><button id="ajaxOkBtnPresc" type="button" class="btn btn-primary">OK</button></div>' +
                    '</div></div></div>';

                var div = document.createElement('div');
                div.innerHTML = html;
                document.body.appendChild(div);
                var modalEl = document.getElementById(modalId);
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
                document.getElementById('ajaxOkBtnPresc').addEventListener('click', function(){
                    modal.hide();
                    window.location = url;
                });
            }

            function encodeHtml(s){ var div = document.createElement('div'); div.innerText = s; return div.innerHTML; }
            function validateForm(formEl) {
                var controls = formEl.querySelectorAll('input,select,textarea');
                var ok = true;
                controls.forEach(function(c){
                    if (c.type === 'hidden') return;
                    var valid = true;
                    if (typeof c.checkValidity === 'function') valid = c.checkValidity();
                    if (!valid) {
                        c.classList.add('is-invalid');
                        var fb = c.parentNode.querySelector('.invalid-feedback') || c.parentNode.querySelector('.text-danger');
                        if (!fb) { fb = document.createElement('div'); fb.className='invalid-feedback'; c.parentNode.appendChild(fb); }
                        try { fb.innerText = c.validationMessage || 'This field is required'; } catch(e){}
                        ok = false;
                    } else {
                        c.classList.remove('is-invalid');
                        var fb = c.parentNode.querySelector('.invalid-feedback'); if (fb) fb.innerText = '';
                    }
                });
                return ok;
            }
        })();
    </script>
}
