@model CAS.Models.ViewModel.AppointmentListViewModel

@{
    ViewData["Title"] = "My Appointments";
}

<style>

    /* ================= BACKGROUND ================= */
    .status-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= CARD / TABLE STYLING (polished) ================= */
    .inventory-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
        animation: fadeUp 0.8s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .inventory-title {
        font-weight: 700;
        color: #124E66;
    }

    .table {
        border-radius: 15px;
        overflow: hidden;
    }

        .table thead {
            background: linear-gradient(45deg,#124E66,#748D92);
            color: white;
        }

            .table thead th {
                border: none;
                padding: 15px;
            }

        .table tbody td {
            padding: 15px;
            vertical-align: middle;
        }

        .table tbody tr {
            transition: 0.3s;
        }

            .table tbody tr:hover {
                background-color: rgba(18,78,102,0.08);
                transform: scale(1.01);
            }

    /* ================= SECTION TITLE ================= */
    .section-title {
        font-weight: 700;
        color: #124E66;
        margin-bottom: 15px;
    }

    /* ================= LABEL STYLING ================= */
    .info-label {
        font-weight: 600;
        color: #003135;
    }

    .info-value {
        color: #555;
        margin-bottom: 10px;
    }

    /* ================= DATE BADGE ================= */
    .datetime-badge {
        display: inline-block;
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        margin-top: 10px;
    }

    /* ================= ACTION BUTTON ================= */
    .dashboard-btn-outline {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 30px;
        border: 2px solid #964734;
        color: #964734;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .dashboard-btn-outline:hover {
            background: #964734;
            color: white;
            transform: scale(1.05);
        }

    /* ================= EMPTY STATE ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        color: #AFDDE5;
        padding: 20px;
        text-align: center;
    }

</style>

<div class="status-page">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="inventory-card">

                    <h2 class="inventory-title mb-4 text-center">My Appointments</h2>

                    @if (Model == null || Model.Schedules == null || !Model.Schedules.Any())
                    {
                        <div class="custom-alert">
                            <h5 class="mb-2">No appointments scheduled</h5>
                            <p class="mb-3">Patients will appear here once appointments are created.</p>
                            <a asp-action="Index" class="dashboard-btn-outline">Back to Dashboard</a>
                        </div>
                    }
                    else
                    {
                        var list = Model.Schedules.ToList();

                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Patient</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in list)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@s.Appointment.Patient.PatientName</td>
                                            <td>@s.ScheduleDate.ToString("dd MMM yyyy")</td>
                                            <td>@s.ScheduleTime.ToString("hh:mm tt")</td>
                                            <td>
                                                <a asp-action="AppointmentDetails" asp-route-id="@s.AppointmentId" class="dashboard-btn-outline">View Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>

            </div>
        </div>
    </div>

    </div>

</div>
