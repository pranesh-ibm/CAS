@model CAS.Models.ViewModel.AppointmentListViewModel

@{
    ViewData["Title"] = "My Appointments";
}

<style>

    /* ================= BACKGROUND ================= */
    .status-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= CARD ================= */
    .status-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 35px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.25);
        transition: 0.35s ease;
        position: relative;
        overflow: hidden;
    }

        .status-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 35px 70px rgba(0,0,0,0.3);
        }

        .status-card::before {
            content: "";
            position: absolute;
            height: 6px;
            width: 100%;
            top: 0;
            left: 0;
            background: linear-gradient(45deg,#0FA4AF,#964734);
        }

    /* ================= SECTION TITLE ================= */
    .section-title {
        font-weight: 700;
        color: #124E66;
        margin-bottom: 15px;
    }

    /* ================= LABEL STYLING ================= */
    .info-label {
        font-weight: 600;
        color: #003135;
    }

    .info-value {
        color: #555;
        margin-bottom: 10px;
    }

    /* ================= DATE BADGE ================= */
    .datetime-badge {
        display: inline-block;
        background: linear-gradient(45deg,#0FA4AF,#024950);
        color: white;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        margin-top: 10px;
    }

    /* ================= ACTION BUTTON ================= */
    .dashboard-btn-outline {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 30px;
        border: 2px solid #964734;
        color: #964734;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .dashboard-btn-outline:hover {
            background: #964734;
            color: white;
            transform: scale(1.05);
        }

    /* ================= EMPTY STATE ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        color: #AFDDE5;
        padding: 20px;
        text-align: center;
    }

</style>

<div class="status-page">

    <div class="container">

        <div class="text-center mb-5">
            <h2 class="page-title">My Appointments</h2>
        </div>

        @if (Model == null || Model.Schedules == null || !Model.Schedules.Any())
        {
            <div class="custom-alert">
                <h5 class="mb-2">No appointments scheduled</h5>
                <p class="mb-3">
                    Patients will appear here once appointments are created.
                </p>
                <a asp-action="Index" class="dashboard-btn-outline">
                    Back to Dashboard
                </a>
            </div>
        }
        else
        {
            var list = Model.Schedules.ToList();
            var count = list.Count;

            <div class="row g-4 @(count == 1 ? "justify-content-center" : "")">

                @foreach (var s in list)
                {
                    <div class="@(count == 1 ? "col-lg-6 col-md-8" : "col-lg-6")">

                        <div class="status-card h-100">

                            <div class="section-title">
                                📅 Appointment Details
                            </div>

                            <div class="info-value">
                                <span class="info-label">Patient:</span>
                                @s.Appointment.Patient.PatientName
                            </div>

                            <div class="datetime-badge">
                                @s.ScheduleDate.ToString("dd MMM yyyy")
                                •
                                @s.ScheduleTime.ToString("hh:mm tt")
                            </div>

                            <div class="mt-3">
                                <a asp-action="AppointmentDetails"
                                   asp-route-id="@s.AppointmentId"
                                   class="dashboard-btn-outline">
                                    View Details
                                </a>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>
