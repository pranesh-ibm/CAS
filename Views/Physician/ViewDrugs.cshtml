@model CAS.Models.ViewModel.DrugListViewModel

@{
    ViewData["Title"] = "Available Drugs";
}

<style>

    /* ================= BACKGROUND ================= */
    .drugs-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= DRUG CARD ================= */
    .drug-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 30px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.25);
        transition: 0.35s ease;
        position: relative;
        overflow: hidden;
    }

        .drug-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 35px 70px rgba(0,0,0,0.3);
        }

        .drug-card::before {
            content: "";
            position: absolute;
            height: 6px;
            width: 100%;
            top: 0;
            left: 0;
            background: linear-gradient(45deg,#0FA4AF,#964734);
        }

    /* ================= LABELS ================= */
    .info-label {
        font-weight: 600;
        color: #003135;
    }

    .info-value {
        color: #555;
        margin-bottom: 10px;
    }

    /* ================= BUTTON ================= */
    .dashboard-btn-outline {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 30px;
        border: 2px solid #964734;
        color: #964734;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .dashboard-btn-outline:hover {
            background: #964734;
            color: white;
            transform: scale(1.05);
        }

    /* ================= PRIMARY BUTTON ================= */
    .btn-premium {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        border: none;
        border-radius: 30px;
        padding: 10px 20px;
        font-weight: 600;
        color: white;
        transition: 0.3s ease;
    }

        .btn-premium:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(15,164,175,0.6);
            color: white;
        }

    /* ================= EMPTY STATE ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        color: #AFDDE5;
    }

</style>

<div class="drugs-page">

    <div class="container">

        <div class="text-center mb-5">
            <h2 class="page-title">Available Drugs</h2>
        </div>

        @if (Model == null || Model.Drugs == null || !Model.Drugs.Any())
        {
            <div class="custom-alert">
                <h5 class="mb-3">No drugs available</h5>
                <p class="mb-4">
                    There are currently no active drugs in the system.
                    Please check back later or contact the pharmacy team.
                </p>

                <a asp-action="ViewDrugs"
                   class="dashboard-btn-outline me-3">
                    Refresh
                </a>

                <a asp-action="OrderDrugs"
                   class="btn-premium">
                    Order Drugs
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var d in Model.Drugs)
                {
                    <div class="col-lg-6 col-md-6">

                        <div class="drug-card h-100">

                            <div class="mb-3">
                                <span class="info-label">Title:</span>
                                <div class="info-value">@d.DrugTitle</div>
                            </div>

                            <div class="mb-3">
                                <span class="info-label">Description:</span>
                                <div class="info-value">
                                    @d.Description
                                </div>
                            </div>

                            <div class="mb-3">
                                <span class="info-label">Expiry:</span>
                                <div class="info-value">
                                    @(d.Expiry.HasValue? d.Expiry.Value.ToString("dd MMM yyyy") : "-")
                                </div>
                            </div>

                            <div>
                                <span class="info-label">Dosage:</span>
                                <div class="info-value">@d.Dosage</div>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>
