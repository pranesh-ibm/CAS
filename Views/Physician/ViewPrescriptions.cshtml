@model CAS.Models.ViewModel.PrescriptionListViewModel

@{
    ViewData["Title"] = "View Prescriptions";
}

@await Html.PartialAsync("_SuccessModal")

<style>

    /* ================= BACKGROUND ================= */
    .prescriptions-page {
        background: linear-gradient(135deg,#003135,#024950,#0FA4AF);
        background-size: 300% 300%;
        animation: bgMove 14s ease infinite;
        min-height: 100vh;
        padding: 80px 0;
    }

    @@keyframes bgMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* ================= HEADER ================= */
    .page-title {
        color: #AFDDE5;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* ================= CARD / TABLE STYLING (polished) ================= */
    .inventory-card {
        background: rgba(255,255,255,0.95);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
        animation: fadeUp 0.8s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .inventory-title {
        font-weight: 700;
        color: #124E66;
    }

    .table {
        border-radius: 15px;
        overflow: hidden;
    }

        .table thead {
            background: linear-gradient(45deg,#124E66,#748D92);
            color: white;
        }

            .table thead th {
                border: none;
                padding: 15px;
            }

        .table tbody td {
            padding: 15px;
            vertical-align: middle;
        }

        .table tbody tr {
            transition: 0.3s;
        }

            .table tbody tr:hover {
                background-color: rgba(18,78,102,0.08);
                transform: scale(1.01);
            }

    /* ================= LABELS ================= */
    .info-label {
        font-weight: 600;
        color: #003135;
    }

    .info-value {
        color: #555;
        margin-bottom: 10px;
    }

    /* ================= BUTTONS ================= */
    .btn-premium {
        background: linear-gradient(45deg,#0FA4AF,#024950);
        border: none;
        border-radius: 30px;
        padding: 10px 20px;
        font-weight: 600;
        color: white;
        transition: 0.3s ease;
    }

        .btn-premium:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(15,164,175,0.6);
            color: white;
        }

    .dashboard-btn-outline {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 30px;
        border: 2px solid #964734;
        color: #964734;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .dashboard-btn-outline:hover {
            background: #964734;
            color: white;
            transform: scale(1.05);
        }

    /* ================= EMPTY STATE ================= */
    .custom-alert {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        color: #AFDDE5;
    }

</style>

<div class="prescriptions-page">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="inventory-card">

                    <h2 class="inventory-title mb-4 text-center">Prescriptions</h2>

                    @if (Model == null || Model.Prescriptions == null || !Model.Prescriptions.Any())
                    {
                        <div class="custom-alert">
                            <h5 class="mb-3">No prescriptions found</h5>
                            <p class="mb-4">There are no prescriptions available for your account right now.</p>

                            <a asp-action="CreatePrescription" class="btn-premium me-3">Create Prescription</a>
                            <a asp-action="ViewPrescriptions" class="dashboard-btn-outline">Refresh</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Patient</th>
                                        <th>Drug</th>
                                        <th>Prescription</th>
                                        <th>Dosage</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Prescriptions)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@p.PhysicianAdvice.Schedule.Appointment.Patient.PatientName</td>
                                            <td>@p.Drug.DrugTitle</td>
                                            <td>@p.Prescription</td>
                                            <td>@p.Dosage</td>
                                            <td>@p.PhysicianAdvice.Schedule.ScheduleDate.ToString("dd MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>

            </div>
        </div>
    </div>

    </div>

</div>

@section Scripts {
    <script>
        (function(){
            var modalEl = document.getElementById('successModal');
            if (modalEl && typeof bootstrap !== 'undefined'){
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        })();
    </script>
}
