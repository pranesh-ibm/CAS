@model CAS.Models.ViewModel.PhysicianProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<h2>Edit Profile</h2>

<form id="physEditForm" asp-controller="Physician" asp-action="EditProfile" method="post" novalidate>
        @Html.AntiForgeryToken()
    <div id="physFormSummary" class="text-danger"></div>
    <input type="hidden" asp-for="PhysicianId" />

    <div class="mb-3">
        <label asp-for="PhysicianName" class="form-label"></label>
        <input asp-for="PhysicianName" class="form-control" required />
        <div class="invalid-feedback" asp-validation-for="PhysicianName"></div>
    </div>

    <div class="mb-3">
        <label asp-for="Specialization" class="form-label"></label>
        <input asp-for="Specialization" class="form-control" required />
        <div class="invalid-feedback" asp-validation-for="Specialization"></div>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" required />
        <div class="invalid-feedback" asp-validation-for="Address"></div>
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" required />
        <div class="invalid-feedback" asp-validation-for="Phone"></div>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" required />
        <div class="invalid-feedback" asp-validation-for="Email"></div>
    </div>

    <div class="mb-3">
        <label asp-for="Summary" class="form-label"></label>
        <textarea asp-for="Summary" class="form-control" required></textarea>
        <div class="invalid-feedback" asp-validation-for="Summary"></div>
    </div>

    <button type="button" id="physSaveBtn" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function(){
            var form = document.getElementById('physEditForm');
            var btn = document.getElementById('physSaveBtn');
            var summary = document.getElementById('physFormSummary');
            if(!form || !btn) return;

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                summary.innerText = '';

                // Prefer native reportValidity if available
                if (typeof form.reportValidity === 'function') {
                    if (!form.reportValidity()) return;
                } else {
                    if (!validateForm(form)) return;
                }

                // submit via fetch
                (async function(){
                    try {
                        var fd = new FormData(form);
                        var res = await fetch(form.action, {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            credentials: 'same-origin',
                            body: fd
                        });
                        if (!res.ok) {
                            var err = 'An error occurred while saving.';
                            try { var body = await res.json(); if (body && body.message) err = body.message; } catch(e){}
                            summary.innerText = err;
                            return;
                        }
                        var json = await res.json();
                        if (json && json.success) {
                            showModalAndRedirect(json.message || 'Saved', '@Url.Action("Index", "Physician")');
                            return;
                        }
                        summary.innerText = (json && json.message) ? json.message : 'An unexpected response was received.';
                    } catch (ex) {
                        summary.innerText = 'Network error while saving.';
                    }
                })();
            }, false);

            function showModalAndRedirect(message, url) {
                var modalId = 'ajaxSuccessModal';
                var existing = document.getElementById(modalId);
                if (existing) existing.remove();

                var html = '<div class="modal fade" id="' + modalId + '" tabindex="-1" aria-hidden="true">' +
                    '<div class="modal-dialog modal-dialog-centered"><div class="modal-content">' +
                    '<div class="modal-header"><h5 class="modal-title">Success</h5>' +
                    '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>' +
                    '<div class="modal-body">' + encodeHtml(message) + '</div>' +
                    '<div class="modal-footer"><button id="ajaxOkBtn" type="button" class="btn btn-primary">OK</button></div>' +
                    '</div></div></div>';

                var div = document.createElement('div');
                div.innerHTML = html;
                document.body.appendChild(div);
                var modalEl = document.getElementById(modalId);
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
                document.getElementById('ajaxOkBtn').addEventListener('click', function(){
                    modal.hide();
                    window.location = url;
                });
            }

            function encodeHtml(s){ var div = document.createElement('div'); div.innerText = s; return div.innerHTML; }

            function validateForm(formEl) {
                var controls = formEl.querySelectorAll('input,select,textarea');
                var ok = true;
                controls.forEach(function(c){
                    if (c.type === 'hidden') return;
                    var valid = true;
                    if (typeof c.checkValidity === 'function') valid = c.checkValidity();
                    if (!valid) {
                        c.classList.add('is-invalid');
                        // set or create invalid-feedback
                        var fb = c.parentNode.querySelector('.invalid-feedback') || c.parentNode.querySelector('.text-danger');
                        if (!fb) {
                            fb = document.createElement('div'); fb.className = 'invalid-feedback'; c.parentNode.appendChild(fb);
                        }
                        try { fb.innerText = c.validationMessage || 'This field is required'; } catch(e){}
                        ok = false;
                    } else {
                        c.classList.remove('is-invalid');
                        var fb = c.parentNode.querySelector('.invalid-feedback'); if (fb) fb.innerText = '';
                    }
                });
                return ok;
            }
        })();
    </script>

    @{
        var msg = TempData["SuccessMessage"] as string;
    }

    @if (!string.IsNullOrEmpty(msg))
    {
        <script>
            (function(){
                var modalHtml = '<div class="modal fade" id="tempSuccessModal" tabindex="-1" aria-hidden="true">' +
                                '<div class="modal-dialog modal-dialog-centered">' +
                                '<div class="modal-content">' +
                                '<div class="modal-header"><h5 class="modal-title">Success</h5>' +
                                '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>' +
                                '<div class="modal-body">' + @Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(msg)) + '</div>' +
                                '<div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button></div>' +
                                '</div></div></div>';
                var div = document.createElement('div');
                div.innerHTML = modalHtml;
                document.body.appendChild(div);
                var modalEl = document.getElementById('tempSuccessModal');
                if (modalEl){
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();
                }
            })();
        </script>
    }
}
