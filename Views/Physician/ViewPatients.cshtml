@model CAS.Models.ViewModel.PatientListViewModel

@{
    ViewData["Title"] = "View Patients";
}

<h2>Assigned Patients</h2>

@if (Model == null || Model.Patients == null || !Model.Patients.Any())
{
    <div class="text-center py-5 text-muted">
        <h5 class="mb-2">No patients assigned</h5>
        <p class="mb-3">There are currently no patients linked to your account. This could be because schedules haven't been created or patients haven't been assigned yet.</p>
        <a asp-action="ViewPatients" class="btn btn-outline-secondary me-2">Refresh</a>
        <a asp-action="Index" class="btn btn-link">Back to Dashboard</a>
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Gender</th>
                <th>Phone</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Patients)
        {
            <tr>
                <td>@p.PatientName</td>
                <td>@(p.Gender ?? "-")</td>
                <td>@p.Phone</td>
                <td class="text-end">
                    <a asp-action="PatientDetails" asp-route-id="@p.PatientId" class="btn btn-sm btn-outline-primary">View</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
